+"""Tests for the TinyFish provider adapter (03_scripts/ghoti_runtime/tinyfish.py).
+
+No network: every provider call goes through a scripted fake transport. Each test uses its own RunStore root
+under the engineering scratch folder and asserts persisted state (run record, output file, store.state()) and
+the exact transport calls.
+
+    python -I -B -m unittest 01_projects/ghoti_os_app/tests/test_tinyfish_adapter.py
+"""
+import contextlib
+import copy
+import io
+import json
+import os
+from pathlib import Path
+import shutil
+import sys
+import tempfile
+import unittest
+
+REPO = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO / "03_scripts"))
+
+from ghoti_runtime import tinyfish  # noqa: E402
+from ghoti_runtime.run_store import RunStore  # noqa: E402
+
+KEY = "tf_SYNTHETIC_TEST_KEY_1234567890"
+TEST_BASE = Path(os.environ.get("GHOTI_TF_TEST_ROOT", tempfile.gettempdir())) / "ghoti-tf-tests"
+URL = "https://docs.tinyfish.ai/page"
+QUESTION = "List the supported features"
+START = "/v1/automation/run-async"
+FORBIDDEN_FIELDS = ("use_vault", "use_profile", "credential_item_ids", "webhook_url", "proxy_config")
+VALID_RESULT = {"summary": "Docs summary", "items": [
+    {"name": "Feature A", "detail": "Does A", "source_url": "https://docs.tinyfish.ai/a"},
+    {"name": "Feature B", "detail": "Does B", "source_url": "https://docs.tinyfish.ai/b"}]}
+
+
+def resp(status, obj=None, raw=None):
+    return tinyfish.Response(status, raw if raw is not None else json.dumps(obj).encode())
+
+
+def run_body(run_id, status, **extra):
+    return {"run_id": run_id, "status": status, "created_at": "2026-01-01T00:00:00Z", **extra}
+
+
+def completed(run_id="run_1", result=VALID_RESULT):
+    return resp(200, run_body(run_id, "COMPLETED", result=result, finished_at="2026-01-01T00:01:00Z", num_of_steps=3))
+
+
+class Clock:
+    def __init__(self):
+        self.t = 1_000_000.0
+
+    def __call__(self):
+        return self.t
+
+    def sleep(self, seconds):
+        self.t += seconds
+
+
+class Fake:
+    """Records every (method, path, body); serves scripted queues for start, get and cancel.
+
+    A scripted item is a Response (returned), an Exception instance (raised) or a callable(fake, method, path, body).
+    """
+
+    def __init__(self, start=(), get=(), cancel=()):
+        self.calls = []
+        self.queues = {"start": list(start), "get": list(get), "cancel": list(cancel)}
+
+    def request(self, method, path, body=None):
+        self.calls.append((method, path, copy.deepcopy(body)))
+        kind = "get" if method == "GET" else "cancel" if path.endswith("/cancel") else "start"
+        if not self.queues[kind]:
+            raise AssertionError(f"unscripted {kind} call: {method} {path}")
+        item = self.queues[kind].pop(0)
+        if isinstance(item, Exception):
+            raise item
+        return item(self, method, path, body) if callable(item) else item
+
+    def of(self, kind):
+        def classify(call):
+            return "get" if call[0] == "GET" else "cancel" if call[1].endswith("/cancel") else "start"
+        return [c for c in self.calls if classify(c) == kind]
+
+    @property
+    def posts(self):
+        return [c for c in self.calls if c[0] == "POST"]
+
+
+class Base(unittest.TestCase):
+    def setUp(self):
+        TEST_BASE.mkdir(parents=True, exist_ok=True)
+        self.roots = []
+
+    def tearDown(self):
+        for root in self.roots:
+            shutil.rmtree(root, ignore_errors=True)
+
+    def env(self, fake=None, key=KEY, approve=True, **cfg):
+        root = Path(tempfile.mkdtemp(dir=TEST_BASE))
+        self.roots.append(root)
+        self.store = RunStore(root)
+        if approve:
+            record = {"schema": "ghoti_tinyfish_approval/1", "enabled": True, "approval_request_id": "approval-tinyfish-test",
+                      "approved_hosts": ["docs.tinyfish.ai"], "expires_at": "2099-01-01T00:00:00+00:00", **cfg}
+            self.store.write("ghoti_provider_config/tinyfish.json", record)
+        self.fake = fake if fake is not None else Fake()
+        self.clock = Clock()
+        self.tf = tinyfish.TinyFish(self.store, transport=self.fake, api_key=key, clock=self.clock, sleep=self.clock.sleep)
+        return self.tf
+
+    # -- persisted-state helpers
+    def record(self, task_id):
+        return self.store.read(f"ghoti_runtime_runs/{task_id}.json")
+
+    def output_path(self, task_id):
+        return self.store.path(f"ghoti_runtime_runs/{task_id}.output.json")
+
+    def job(self, task_id):
+        jobs = [j for j in self.store.state()["jobs"] if j["task_id"] == task_id]
+        self.assertEqual(len(jobs), 1)
+        return jobs[0]
+
+    def assert_state(self, task_id, provider_state, task_state, run_id=None):
+        record = self.record(task_id)
+        self.assertEqual(record["provider"]["state"], provider_state)
+        self.assertEqual(record["task"]["state"], task_state)
+        job = self.job(task_id)
+        self.assertEqual(job["provider"]["state"], provider_state)
+        self.assertEqual(job["state"], task_state)
+        self.assertEqual(job["provider"]["run_id"], run_id)
+        return record
+
+    def started(self, run_id="run_1", **cfg):
+        """A fresh environment with one accepted run."""
+        self.env(Fake(start=[resp(200, {"run_id": run_id})]), **cfg)
+        out = self.tf.start(URL, QUESTION)
+        self.assertEqual(out["status"], "ACCEPTED")
+        return out["task_id"]
+
+    def all_store_bytes(self):
+        for dirpath, _, files in os.walk(self.store.root):
+            for name in files:
+                yield Path(dirpath, name), (Path(dirpath) / name).read_bytes()
+
+
+class NotConfigured(Base):
+    def test_1a_no_approval_file(self):
+        tf = self.env(approve=False)
+        out = tf.start(URL, QUESTION)
+        self.assertEqual(out["status"], "NOT_CONFIGURED")
+        self.assertEqual(self.fake.calls, [])
+        record = self.assert_state(out["task_id"], "not_configured", "blocked")
+        self.assertIsNone(record["provider"]["run_id"])
+        self.assertEqual(self.job(out["task_id"])["provider"]["error_category"], "NOT_CONFIGURED")
+        self.assertFalse(record["provider_called"])
+        self.assertEqual(tf.readiness()["state"], "not_configured")
+
+    def test_1b_approval_but_empty_key(self):
+        for key in ("", None):
+            with self.subTest(key=key):
+                saved = os.environ.pop(tinyfish.ENV_KEY, None)  # None would fall back to the environment variable
+                try:
+                    tf = self.env(key=key)
+                    out = tf.start(URL, QUESTION)
+                finally:
+                    if saved is not None:
+                        os.environ[tinyfish.ENV_KEY] = saved
+                self.assertEqual(out["status"], "NOT_CONFIGURED")
+                self.assertEqual(self.fake.calls, [])
+                self.assert_state(out["task_id"], "not_configured", "blocked")
+                self.assertEqual(tf.readiness()["state"], "not_configured")
+
+    def test_1c_disabled_or_wrong_schema_is_not_configured(self):
+        for patch in ({"enabled": False}, {"schema": "other/1"}, {"approved_hosts": []}):
+            with self.subTest(patch=patch):
+                tf = self.env(**patch)
+                self.assertEqual(tf.start(URL, QUESTION)["status"], "NOT_CONFIGURED")
+                self.assertEqual(self.fake.calls, [])
+
+
+    def test_1d_invalid_approved_host_is_not_configured_not_a_crash(self):
+        # load_config's docstring: "Absent, disabled or invalid means not configured."
+        for hosts in (["127.0.0.1"], ["localhost"], ["bad host"]):
+            with self.subTest(hosts=hosts):
+                tf = self.env(approved_hosts=hosts)
+                self.assertEqual(tf.readiness()["state"], "not_configured")
+                self.assertEqual(tf.start(URL, QUESTION)["status"], "NOT_CONFIGURED")
+                self.assertEqual(self.fake.calls, [])
+
+
+class Policy(Base):
+    def test_2_policy_rejection_before_any_transport_call(self):
+        cases = [
+            ("http url", "http://docs.tinyfish.ai/page", QUESTION),
+            ("non-approved host", "https://evil.example.org/page", QUESTION),
+            ("ip literal", "https://93.184.216.34/page", QUESTION),
+            ("localhost", "https://localhost/page", QUESTION),
+            ("credentials in url", "https://user:pw@docs.tinyfish.ai/page", QUESTION),
+            ("other port", "https://docs.tinyfish.ai:8443/page", QUESTION),
+            ("question with another url", URL, "also read https://evil.example.org/x"),
+            ("question with an ip", URL, "check 10.0.0.5 too"),
+        ]
+        for label, url, question in cases:
+            with self.subTest(label):
+                tf = self.env()
+                with self.assertRaises(ValueError):
+                    tf.start(url, question)
+                self.assertEqual(self.fake.calls, [])
+                self.assertEqual(self.store.recent(), [])  # nothing was recorded either
+
+
+class Auth(Base):
+    def test_3a_auth_failure_on_start_is_rejected_without_retry(self):
+        self.env(Fake(start=[resp(401, {"error": {"code": "UNAUTHORIZED", "message": "bad key"}})]))
+        out = self.tf.start(URL, QUESTION)
+        self.assertEqual(out["status"], "REJECTED")
+        self.assertEqual(out["error"]["category"], "AUTHENTICATION")
+        self.assertEqual(self.fake.calls, [("POST", START, self.fake.calls[0][2])])
+        record = self.assert_state(out["task_id"], "rejected", "failed", run_id=None)
+        self.assertEqual(self.job(out["task_id"])["provider"]["error_category"], "AUTHENTICATION")
+        self.assertTrue(record["provider_called"])
+        self.assertFalse(self.output_path(out["task_id"]).exists())
+        self.assertEqual(self.tf.resume(), [])
+        self.assertEqual(len(self.fake.calls), 1)
+
+    def test_3b_auth_failure_on_poll_is_status_unavailable_not_terminal(self):
+        task = self.started()
+        self.fake.queues["get"] = [resp(401, {"error": {"message": "bad key"}})]
+        out = self.tf.poll(task)
+        self.assertEqual(out["status"], "STATUS_UNAVAILABLE")
+        self.assert_state(task, "status_unavailable", "executing", run_id="run_1")
+        self.assertNotIn(self.record(task)["provider"]["state"], ("completed", "failed", "rejected", "cancelled"))
+        self.assertFalse(self.output_path(task).exists())
+        self.assertEqual(len(self.fake.posts), 1)  # no resubmission, no cancel
+
+
+class Malformed(Base):
+    def test_4a_non_json_start_response_is_submission_unconfirmed(self):
+        for label, response in (("html", resp(200, raw=b"<html>oops</html>")), ("empty", resp(200, raw=b"")),
+                                ("array", resp(200, ["x"])), ("no run id", resp(200, {"ok": True})),
+                                ("bad run id", resp(200, {"run_id": "../../etc"}))):
+            with self.subTest(label):
+                self.env(Fake(start=[response]))
+                out = self.tf.start(URL, QUESTION)
+                self.assertEqual(out["status"], "SUBMISSION_UNCONFIRMED", label)
+                self.assertEqual(len(self.fake.posts), 1)
+                self.assert_state(out["task_id"], "submission_unconfirmed", self.record(out["task_id"])["task"]["state"], run_id=None)
+                self.assertEqual(self.tf.resume(), [])
+                self.assertEqual(len(self.fake.calls), 1, "no second POST and no GET")
+
+    def test_4b_completed_without_valid_result(self):
+        bad_items = [{"name": "A", "detail": "d", "source_url": "https://docs.tinyfish.ai/a"}]
+        cases = {
+            "result null": None,
+            "not an object": "plain text",
+            "no items": {"summary": "s", "items": []},
+            "items wrong type": {"summary": "s", "items": "nope"},
+            "summary missing": {"items": bad_items},
+            "too many items": {"summary": "s", "items": bad_items * 26},
+            "item not object": {"summary": "s", "items": ["x"]},
+            "item missing detail": {"summary": "s", "items": [{"name": "A", "source_url": "https://docs.tinyfish.ai/a"}]},
+            "bad source_url": {"summary": "s", "items": [{"name": "A", "detail": "d", "source_url": "not a url"}]},
+            "ftp source_url": {"summary": "s", "items": [{"name": "A", "detail": "d", "source_url": "ftp://docs.tinyfish.ai/a"}]},
+            "javascript source_url": {"summary": "s", "items": [{"name": "A", "detail": "d", "source_url": "javascript:alert(1)"}]},
+        }
+        for label, result in cases.items():
+            with self.subTest(label):
+                task = self.started()
+                self.fake.queues["get"] = [completed(result=result)]
+                out = self.tf.poll(task)
+                self.assertEqual(out["status"], "COMPLETED_WITHOUT_VALID_RESULT")
+                self.assertEqual(out["error"]["category"], "INVALID_RESULT")
+                record = self.assert_state(task, "completed_without_valid_result", "failed", run_id="run_1")
+                self.assertFalse(self.output_path(task).exists(), "no output for an unvalidated result")
+                self.assertFalse(record["task"].get("result"))
+
+
+class Throttling(Base):
+    def test_5a_start_429_is_rejected_rate_limited_one_post(self):
+        self.env(Fake(start=[resp(429, {"error": {"code": "RATE_LIMIT", "message": "slow down"}})]))
+        out = self.tf.start(URL, QUESTION)
+        self.assertEqual(out["status"], "REJECTED")
+        self.assertEqual(out["error"]["category"], "RATE_LIMITED")
+        self.assertEqual(len(self.fake.calls), 1)
+        self.assertEqual(self.fake.calls[0][:2], ("POST", START))
+        self.assert_state(out["task_id"], "rejected", "failed", run_id=None)
+        self.assertEqual(self.job(out["task_id"])["provider"]["error_category"], "RATE_LIMITED")
+
+    def test_5b_start_503_is_submission_unconfirmed_and_never_resubmitted(self):
+        self.env(Fake(start=[resp(503, {"error": {"message": "unavailable"}})]))
+        out = self.tf.start(URL, QUESTION)
+        self.assertEqual(out["status"], "SUBMISSION_UNCONFIRMED")
+        self.assertEqual(len(self.fake.posts), 1)
+        record = self.record(out["task_id"])
+        self.assertEqual(record["provider"]["state"], "submission_unconfirmed")
+        self.assertIsNone(record["provider"]["run_id"])
+        self.assertEqual(self.tf.resume(), [])
+        self.assertEqual(self.tf.poll(out["task_id"])["status"], "SUBMISSION_UNCONFIRMED")
+        self.assertEqual(len(self.fake.calls), 1)
+        # the unconfirmed run still counts as active: the same request is refused rather than resent
+        self.assertEqual(self.tf.start(URL, QUESTION)["status"], "DUPLICATE_REFUSED")
+        self.assertEqual(len(self.fake.calls), 1)
+
+
+class Polling(Base):
+    def test_6_interrupted_polling_then_completed(self):
+        task = self.started()
+        self.fake.queues["get"] = [tinyfish.TransportError("ConnectionResetError"), completed()]
+        first = self.tf.poll(task)
+        self.assertEqual(first["status"], "STATUS_UNAVAILABLE")
+        self.assert_state(task, "status_unavailable", "executing", run_id="run_1")
+        self.assertFalse(self.output_path(task).exists())
+        second = self.tf.poll(task)
+        self.assertEqual(second["status"], "COMPLETED")
+        self.assertEqual(second["items"], 2)
+        record = self.assert_state(task, "completed", "succeeded", run_id="run_1")
+        self.assertTrue(record["task"]["result"]["checked"])
+        output = self.store.read(f"ghoti_runtime_runs/{task}.output.json")
+        self.assertEqual(output["task_id"], task)
+        payload = json.loads(output["text"])
+        self.assertEqual(payload["schema"], "ghoti_web_research_result/1")
+        self.assertEqual(payload["run_id"], "run_1")
+        self.assertEqual(payload["source_url"], URL)
+        self.assertEqual(payload["observed_at"], "2026-01-01T00:01:00Z")
+        self.assertEqual(payload["items"], [
+            {"name": "Feature A", "use": "Does A", "source_url": "https://docs.tinyfish.ai/a", "outside_approved_hosts": False},
+            {"name": "Feature B", "use": "Does B", "source_url": "https://docs.tinyfish.ai/b", "outside_approved_hosts": False}])
+        self.assertEqual(payload["sources"], sorted([URL, "https://docs.tinyfish.ai/a", "https://docs.tinyfish.ai/b"]))
+        self.assertTrue(payload["untrusted_content"])
+        self.assertEqual(record["task"]["result"]["output_paths"], [f"ghoti_runtime_runs/{task}.output.json"])
+        self.assertEqual(len(self.fake.posts), 1)
+        self.assertEqual(self.job(task)["provider"]["observed_at"], "2026-01-01T00:01:00Z")
+        # terminal runs are never polled again
+        self.assertEqual(self.tf.poll(task)["status"], "TERMINAL")
+        self.assertEqual(len(self.fake.of("get")), 2)
+
+    def test_6b_run_id_mismatch_in_status_read_is_not_trusted(self):
+        task = self.started()
+        self.fake.queues["get"] = [completed(run_id="some_other_run")]
+        self.assertEqual(self.tf.poll(task)["status"], "STATUS_UNAVAILABLE")
+        self.assert_state(task, "status_unavailable", "executing", run_id="run_1")
+        self.assertFalse(self.output_path(task).exists())
+
