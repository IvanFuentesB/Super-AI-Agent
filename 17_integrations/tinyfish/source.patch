+        self.assertIn("https://", payload["text"])
+        # The same checks local_service applies to a provider record's result:
+        self.assertLessEqual(len(payload["text"]), 8000)
+        self.assertEqual(payload["task_id"], task)
+        record = self.record(task)
+        self.assertEqual(record["provider"]["schema"], "ghoti_provider_run/1")
+
+
+if __name__ == "__main__":
+    unittest.main()
