+++ b/01_projects/ghoti_os_app/tests/test_tinyfish_ui.js
@@ -0,0 +1,264 @@
+"use strict";
+// TinyFish provider rows in the Daily shell: outcome wording, honesty about cancellation, and plain-text results.
+// Synthetic DOM/API only; loads the real chat.js and daily.js into a vm like test_state_honesty.js does.
+const assert = require("node:assert/strict");
+const test = require("node:test");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+const root = process.env.STATIC_ROOT || path.join(__dirname, "../dashboard_app/static");
+
+class Element {
+  constructor(tag = "div") { this.tagName = tag; this.children = []; this.handlers = {}; this.listeners = {}; this.dataset = {}; this.value = ""; this.hidden = false; this.disabled = false; this._text = ""; this.attributes = {}; this.className = ""; }
+  set textContent(v) { this._text = String(v); this.children = []; }
+  get textContent() { return this._text + this.children.map(c => c.textContent).join(" "); }
+  set innerHTML(_) { throw new Error("Unsafe DOM sink"); }
+  get innerHTML() { throw new Error("Unsafe DOM sink"); }
+  insertAdjacentHTML() { throw new Error("Unsafe DOM sink"); }
+  replaceChildren(...nodes) { this._text = ""; this.children = nodes; }
+  append(...nodes) { this.children.push(...nodes); }
+  setAttribute(k, v) { this.attributes[k] = v; }
+  addEventListener(k, f) {
+    (this.listeners[k] ||= []).push(f);
+    this.handlers[k] = (...args) => { const out = this.listeners[k].map(fn => fn(...args)); return out.length === 1 ? out[0] : Promise.all(out); };
+  }
+  focus() {}
+}
+const walk = (el, visit) => { visit(el); el.children.forEach(child => walk(child, visit)); };
+const all = el => { const out = []; walk(el, n => out.push(n)); return out; };
+const settle = async () => { for (let i = 0; i < 6; i += 1) await new Promise(resolve => setImmediate(resolve)); };
+
+async function shell(jobs, results = {}) {
+  const html = fs.readFileSync(path.join(root, "index.html"), "utf8");
+  const elements = Object.fromEntries([...html.matchAll(/id="([^"]+)"/g)].map(m => [m[1], new Element()]));
+  const data = {schema: "ghoti_deployed_runtime/1", deployment: {status: "NOT_INSTALLED"}, live_workers_running: 0,
+    safe_operations: ["capability_lookup"], safe_workflows: [], jobs, memory: {obsidian_reference_count: 0, native_run_count: 0},
+    learning: {status: "NOT_VERIFIED"}, computer_use: {status: "NOT_VERIFIED"}, observations: {
+      scope: "Fixture observation window", verification_scope: "Transport is not task correctness", memory_status: "written", capabilities: [], receipts: []}};
+  const ok = body => ({ok: true, json: async () => body});
+  const context = {document: {getElementById: id => elements[id], createElement: tag => new Element(tag), querySelectorAll: () => [], addEventListener() {}, hidden: false},
+    window: {addEventListener() {}}, navigator: {}, location: {hostname: "example.invalid"},
+    fetch: async url => {
+      if (url === "/api/runtime/state") return ok(data);
+      const m = /^\/api\/runtime\/result\/(.+)$/.exec(url);
+      if (m && results[m[1]] !== undefined) return ok({task_id: m[1], text: results[m[1]]});
+      if (url === "/api/runtime/chat") return ok({schema: "ghoti_chat_state/1", available: true, csrf_token: "fixture-csrf", reasoning_effort: "max", models: [{id: "openai-codex:gpt-6-astra"}], sessions: []});
+      if (url.includes("/events")) return {ok: false, status: 500};
+      return {ok: false, status: 403};
+    },
+    setTimeout() {}, clearTimeout() {}, AbortSignal, TextEncoder, Date, console,
+    crypto: {randomUUID: (() => { let n = 0; return () => `fixture-id-${++n}`; })()}};
+  vm.createContext(context);
+  vm.runInContext(fs.readFileSync(path.join(root, "chat.js"), "utf8"), context);
+  vm.runInContext(fs.readFileSync(path.join(root, "daily.js"), "utf8"), context);
+  await settle();
+  return {elements, context};
+}
+
+// ---------------------------------------------------------------- fixtures
+const PROVIDER_STATES = ["running", "cancel_requested", "cancellation_unconfirmed", "cancelled", "completed",
+  "not_configured", "submission_unconfirmed", "status_unavailable"];
+// The wording and tone daily.js owns (providerOutcomes); asserted here so a drift is caught.
+const EXPECTED = {
+  running: ["Running at TinyFish", "running"],
+  cancel_requested: ["Stop requested · not yet confirmed", "unconfirmed"],
+  cancellation_unconfirmed: ["Cancellation unconfirmed · the run may still be active", "unconfirmed"],
+  cancelled: ["Cancelled at TinyFish (as reported)", "blocked"],
+  completed: ["Completed · review the extracted data", "succeeded"],
+  not_configured: ["Not configured · set up TinyFish first", "blocked"],
+  submission_unconfirmed: ["Submission unconfirmed · not resent; check the provider", "unconfirmed"],
+  status_unavailable: ["Status unavailable · the run may still be active", "unconfirmed"],
+  pending: ["Queued at TinyFish", "running"],
+  submitting: ["Submitting to TinyFish", "running"],
+  rejected: ["Rejected by TinyFish · nothing ran", "failed"],
+  failed: ["Failed at TinyFish", "failed"],
+  completed_without_valid_result: ["Finished without a usable result", "failed"],
+};
+const TASK_STATE = {running: "executing", cancel_requested: "executing", cancellation_unconfirmed: "executing", cancelled: "blocked",
+  completed: "succeeded", not_configured: "blocked", submission_unconfirmed: "executing", status_unavailable: "executing",
+  pending: "executing", submitting: "executing", rejected: "failed", failed: "failed", completed_without_valid_result: "failed"};
+const providerJob = (state, i) => ({task_id: `task-tf-${i}-${state.replaceAll("_", "-")}`, title: "tinyfish_web_research", state: TASK_STATE[state],
+  worker: null, route: {}, running: false, blocker: "", memory_event_id: null, verification_scope: null, provider_called: true,
+  network_scope: "provider:tinyfish (agent.tinyfish.ai)",
+  provider: {provider: "tinyfish", state, run_id: "run_1", source_url: "https://docs.tinyfish.ai/page", observed_at: null,
+    last_polled_at: null, remote_status: null, error_category: null}});
+
+const rowsOf = elements => elements["daily-jobs"].children;
+// children of a record: strong(title), p(outcome), details(task details), ...
+const outcomeOf = row => row.children[1].textContent;
+
+async function expandedJobs(states, results) {
+  const jobs = states.map(providerJob);
+  const s = await shell(jobs, results);
+  if (!s.elements["daily-more-jobs"].hidden) { await s.elements["daily-more-jobs"].handlers.click(); await settle(); }
+  return {...s, jobs};
+}
+
+// ---------------------------------------------------------------- outcome rows
+test("each TinyFish provider state renders its own outcome text and tone", async () => {
+  const {elements, jobs} = await expandedJobs(PROVIDER_STATES);
+  const rows = rowsOf(elements);
+  assert.equal(rows.length, jobs.length);
+  jobs.forEach((job, i) => {
+    const [wording, tone] = EXPECTED[job.provider.state];
+    assert.equal(outcomeOf(rows[i]), wording, job.provider.state);
+    assert.equal(rows[i].dataset.state, tone, job.provider.state);
+    assert.equal(rows[i].children[0].textContent, "Web research · TinyFish (external, metered)", "title uses the operation label");
+  });
+});
+
+test("every other provider state is also worded, never falling back to a local-task phrase", async () => {
+  const states = ["pending", "submitting", "rejected", "failed", "completed_without_valid_result"];
+  const {elements} = await expandedJobs(states);
+  states.forEach((state, i) => assert.equal(outcomeOf(rowsOf(elements)[i]), EXPECTED[state][0], state));
+});
+
+test("cancel_requested and cancellation_unconfirmed never read as stopped or cancelled", async () => {
+  const states = ["cancel_requested", "cancellation_unconfirmed", "status_unavailable", "submission_unconfirmed"];
+  const {elements} = await expandedJobs(states);
+  states.forEach((state, i) => {
+    const row = rowsOf(elements)[i];
+    const text = outcomeOf(row);
+    assert.doesNotMatch(text, /\b(stopped|cancelled|canceled|halted|terminated|ended)\b/i, `${state}: ${text}`);
+    assert.equal(row.dataset.state, "unconfirmed", state);
+    assert.notEqual(row.dataset.state, "blocked", state);
+    assert.notEqual(row.dataset.state, "succeeded", state);
+  });
+  const cancelRows = [rowsOf(elements)[0], rowsOf(elements)[1]];
+  assert.match(outcomeOf(cancelRows[0]), /not yet confirmed/);
+  assert.match(outcomeOf(cancelRows[1]), /may still be active/);
+});
+
+test("only a provider-reported cancelled state reads as cancelled, and it says who reported it", async () => {
+  const {elements} = await expandedJobs(["cancelled"]);
+  assert.equal(outcomeOf(rowsOf(elements)[0]), "Cancelled at TinyFish (as reported)");
+});
+
+test("an unknown provider state is never shown as success or stopped", async () => {
+  const job = providerJob("running", 1);
+  job.provider.state = "something_new";
+  job.state = "succeeded";
+  const {elements} = await shell([job]);
+  const row = rowsOf(elements)[0];
+  assert.equal(outcomeOf(row), "Outcome not confirmed");
+  assert.equal(row.dataset.state, "unconfirmed");
+});
+
+test("a provider run is not shown as Interrupted or Working from local liveness", async () => {
+  const job = providerJob("running", 1);
+  job.running = false;
+  const {elements} = await shell([job]);
+  assert.equal(outcomeOf(rowsOf(elements)[0]), "Running at TinyFish");
+  assert.doesNotMatch(elements["daily-jobs-summary"].textContent, /review/);
+  assert.match(elements["daily-jobs-summary"].textContent, /1 running/);
+});
+
+test("the summary counts unconfirmed provider runs as needing review, not as done or running", async () => {
+  const {elements} = await expandedJobs(["cancel_requested", "cancellation_unconfirmed", "status_unavailable", "completed", "running"]);
+  const summary = elements["daily-jobs-summary"].textContent;
+  assert.match(summary, /1 running/);
+  assert.match(summary, /3 need review/);
+  assert.match(summary, /1 completed/);
+});
+
+// ---------------------------------------------------------------- saved result view
+const WEB_RESULT = {schema: "ghoti_web_research_result/1", provider: "tinyfish", run_id: "run_1", source_url: "https://docs.tinyfish.ai/page",
+  observed_at: "2026-01-01T00:01:00Z", finished_at: "2026-01-01T00:01:00Z", untrusted_content: true, summary: "Docs summary",
+  items: [{name: "Feature A", use: "Does A", source_url: "https://docs.tinyfish.ai/a"},
+    {name: "Feature <b>B</b>", use: "Does B <img src=x onerror=alert(1)>", source_url: "https://docs.tinyfish.ai/b"}],
+  sources: ["https://docs.tinyfish.ai/a", "https://docs.tinyfish.ai/b", "https://docs.tinyfish.ai/page"]};
+
+async function openResult(payload) {
+  const job = providerJob("completed", 1);
+  const {elements} = await shell([job], {[job.task_id]: payload});
+  const row = rowsOf(elements)[0];
+  const button = all(row).find(n => n.tagName === "button" && n.textContent === "Read saved result");
+  assert.ok(button, "Read saved result button is present");
+  await button.handlers.click();
+  await settle();
+  const result = row.children.find(n => n.tagName === "div");
+  assert.ok(result && !result.hidden, "result container is shown");
+  return {row, result};
+}
+
+test("showResult renders web research items, the Observed line and sources as plain text", async () => {
+  const {result} = await openResult(JSON.stringify(WEB_RESULT));
+  const text = result.textContent;
+  assert.match(text, /Feature A/);
+  assert.match(text, /Does A/);
+  assert.match(text, /Observed 2026-01-01T00:01:00Z · page content is untrusted/);
+  const sources = all(result).find(n => n.tagName === "pre" && n.textContent.startsWith("Sources\n"));
+  assert.ok(sources, "sources block");
+  assert.equal(sources.textContent, `Sources\n${WEB_RESULT.sources.join("\n")}`);
+  assert.equal(sources.attributes["aria-label"], "Sources");
+  assert.equal(sources.attributes.role, "group");
+  assert.equal(sources.tabIndex, 0);
+  // item records: one per item, name then use
+  const articles = all(result).filter(n => n.tagName === "article");
+  assert.equal(articles.length, WEB_RESULT.items.length);
+  assert.equal(articles[0].children[0].textContent, "Feature A");
+  assert.equal(articles[0].children[1].textContent, "Does A");
+  const meta = all(result).find(n => n.className === "record-meta");
+  assert.ok(meta && meta.tagName === "p");
+  assert.match(meta.textContent, /^Observed /);
+});
+
+test("showResult never creates anchors or touches innerHTML, and markup in page data stays literal text", async () => {
+  const {result} = await openResult(JSON.stringify(WEB_RESULT));
+  const nodes = all(result);
+  assert.equal(nodes.filter(n => n.tagName === "a").length, 0, "no anchor elements");
+  assert.equal(nodes.filter(n => ["img", "script", "iframe", "form", "button", "input"].includes(n.tagName)).length, 0);
+  assert.ok(nodes.every(n => !("href" in n) && !("src" in n)), "nothing is linkable");
+  assert.ok(nodes.every(n => !Object.keys(n.listeners).includes("click")), "no click handlers in the result");
+  assert.match(result.textContent, /Feature <b>B<\/b>/, "markup is text, not parsed");
+  assert.match(result.textContent, /onerror=alert\(1\)/);
+  // The fixture's innerHTML setter throws; reaching this assertion means it was never used.
+});
+
+test("showResult keeps the full payload under Result details and hides nothing about untrusted status", async () => {
+  const {result} = await openResult(JSON.stringify(WEB_RESULT));
+  const details = all(result).find(n => n.tagName === "details" && n.className === "d-details");
+  assert.ok(details);
+  assert.equal(details.children[0].textContent, "Result details");
+  assert.equal(JSON.parse(details.children[1].textContent).untrusted_content, true);
+  assert.match(result.textContent, /page content is untrusted/);
+});
+
+test("a web research payload with an invalid item shape is not rendered as item records", async () => {
+  const bad = {...WEB_RESULT, items: [{name: "A", detail: "wrong field name", source_url: "https://docs.tinyfish.ai/a"}]};
+  const {result} = await openResult(JSON.stringify(bad));
+  assert.equal(all(result).filter(n => n.tagName === "article").length, 0);
+  assert.doesNotMatch(result.textContent, /Observed/);
+  assert.match(result.textContent, /structured result was saved/i);
+});
+
+test("a result whose task id does not match is refused", async () => {
+  const job = providerJob("completed", 1);
+  const s = await shell([job], {});
+  const original = s.context.fetch;
+  s.context.fetch = async (url, init) => /\/api\/runtime\/result\//.test(url)
+    ? {ok: true, json: async () => ({task_id: "task-other", text: JSON.stringify(WEB_RESULT)})} : original(url, init);
+  const row = rowsOf(s.elements)[0];
+  const button = all(row).find(n => n.tagName === "button");
+  await button.handlers.click();
+  await settle();
+  const result = row.children.find(n => n.tagName === "div");
+  assert.match(result.textContent, /Saved result unavailable/);
+  assert.doesNotMatch(result.textContent, /Feature A/);
+});
+
+test("an active provider run nobody is following says so and never reads as stopped", async () => {
+  const job = providerJob("running", 1);
+  job.provider.stale = true;
+  const {elements} = await shell([job]);
+  const text = outcomeOf(rowsOf(elements)[0]);
+  assert.equal(text, "Running at TinyFish · not being followed; check status");
+  assert.doesNotMatch(text, /\b(stopped|cancelled|completed)\b/i);
+});
+
+test("an owner-resolved submission with no provider run is closed, not completed", async () => {
+  const job = providerJob("failed", 1);
+  job.provider.state = "no_run_found";
+  const {elements} = await shell([job]);
+  assert.equal(outcomeOf(rowsOf(elements)[0]), "Closed · no TinyFish run existed");
+});
diff --git a/03_scripts/ghoti_runtime/TINYFISH.md b/03_scripts/ghoti_runtime/TINYFISH.md
new file mode 100644
index 0000000000000000000000000000000000000000..3cccb403cd741011f951b73186bb1f57e702d194
--- /dev/null
+++ b/03_scripts/ghoti_runtime/TINYFISH.md
@@ -0,0 +1,67 @@
+# TinyFish provider (optional, disabled by default)
+
+Public-web research and structured extraction through the TinyFish Agent API, recorded in Ghoti's existing
+run records and shown in the existing jobs and result views. This is an adapter, not a browser framework,
+memory store or orchestrator.
+
+## Provider contract used (docs.tinyfish.ai, read 2026-11-17)
+| Call | Use in Ghoti |
+|---|---|
+| `POST https://agent.tinyfish.ai/v1/automation/run-async` (header `X-API-Key`) → `{run_id, error}` | The only start used. Async runs are cancellable; the synchronous `/run` is not, so it is never used. |
+| `GET /v1/runs/{id}?screenshots=none&html=none` → `status` `PENDING`/`RUNNING`/`COMPLETED`/`FAILED`/`CANCELLED` | Following a run. Terminal statuses never change. |
+| `POST /v1/runs/{id}/cancel` → `{status, cancelled_at, message}` (idempotent) | Stop. The response is recorded as an acknowledgment only. |
+
+Documented facts that shape the adapter:
+- **COMPLETED is not success.** A COMPLETED run does not mean the goal was met: login walls, bot blocks and step or time limits can also end COMPLETED. Ghoti accepts a result only after local schema validation; otherwise the state is `completed_without_valid_result`.
+- **Cancellation:** the cancel response does not prove the browser stopped. Ghoti reports `cancelled` only after a later status read returns `CANCELLED`. Every other outcome is `cancel_requested` or `cancellation_unconfirmed`.
+- **No read-only mode.** The agent can click, fill forms and log in. The goal text asks for read-only extraction, but that is **not an enforceable boundary**. The enforceable controls are listed below.
+- **Bounds:**
+  - `max_duration_seconds` is not hard-enforced (runs overshoot by roughly 10 seconds).
+  - `max_steps` is a provider beta, so it is off by default.
+  - Ghoti adds its own local deadline, after which it requests cancellation. It reports `cancellation_unconfirmed` until the provider confirms.
+- **Rate limits:** a 429 is a pending-run cap with no `Retry-After`. Ghoti records the start as rejected and never retries submission automatically.
+- **No idempotency key.** Duplicate protection is local: the submission intent is recorded before the request; an identical request is refused while one is active; and an uncertain submission (no response, 5xx, malformed 200) is **never resubmitted**. If you find the run on the TinyFish dashboard, attach it with `adopt`.
+
+## Controls Ghoti enforces
+- **Disabled by default.** The adapter needs both `TINYFISH_API_KEY` in the runtime process environment and an owner approval record (below). Otherwise each attempt is recorded as `not_configured` and nothing is sent.
+- **Targets:** https only, default port, no credentials. No query string or fragment, and no encoded or backslash host. The hostname must be on the owner's `approved_hosts` list. IP literals, numeric hosts, `localhost` and private-use suffixes are refused. The normalized URL is what is sent.
+- **Task text:** it may not name other sites, domains or addresses. It is quoted as data first, and the rules follow it, including "stay on <host>; do not follow links or redirects to other hosts". Redirects or links on an approved host can still move the provider's agent; that cannot be enforced locally. Result items citing other hosts are flagged.
+- **Approval scope:** the approval record must carry an `expires_at` in the future. It caps runs per day (`max_runs_per_day`, default 5) and concurrency. Only the `lite` browser profile is accepted; `stealth`, which exists for bot-detection evasion, is refused. The record's digest is pinned into each run record.
+- **Never sent:** `use_vault`, `use_profile`, `credential_item_ids`, `webhook_url` and `proxy_config`. No memory or context is sent; the request carries only the URL and goal.
+- **Limits:** one active run by default (`max_concurrent_runs` 1..2), and bounded duration.
+- **Key handling:** the key is read only from the environment and sent only in the request header. It is redacted from every stored event and error. The transport ignores environment proxies and refuses redirects, so the key never follows a 3xx to another host.
+- **Bounded records:** provider-controlled values are stored with size limits, so a run record cannot grow beyond the store limit and disappear from the jobs list.
+- **Locking:** every record change happens under one provider lock, including the start request. A record left `submitting` by a dead process becomes `submission_unconfirmed` and is never resubmitted.
+- **Untrusted content:** results are stored as data. The UI renders them as plain text: no HTML, no links.
+
+## Configure (host owner)
+1. Create a TinyFish API key at agent.tinyfish.ai/api-keys under your own account. Ghoti never purchases credits or enables auto-recharge.
+2. Make `TINYFISH_API_KEY` available to the Ghoti runtime process through your existing environment mechanism. `ghoti doctor` reports only that the name is present.
+3. Write the approval record `<runtime root>/ghoti_provider_config/tinyfish.json`, starting from `23_configs/tinyfish.example.json`. Set `enabled: true`, your own `approval_request_id`, and only public hosts you approve.
+4. Check: `python -I 03_scripts/ghoti_runtime/tinyfish.py status` must report `"state": "ready"`.
+
+## Use
+```
+python -I 03_scripts/ghoti_runtime/tinyfish.py start --url https://docs.tinyfish.ai/ --question "List the supported API features"
+python -I 03_scripts/ghoti_runtime/tinyfish.py follow <task_id> --seconds 180
+python -I 03_scripts/ghoti_runtime/tinyfish.py cancel <task_id>
+python -I 03_scripts/ghoti_runtime/tinyfish.py resume          # after an interruption: re-reads known run ids, never resubmits
+python -I 03_scripts/ghoti_runtime/tinyfish.py adopt <task_id> --run-id <id>   # attach a run found on the dashboard
+python -I 03_scripts/ghoti_runtime/tinyfish.py resolve <task_id> --no-run-found   # the dashboard shows no such run
+```
+The CLI always uses the installed runtime's approval record and run records; it has no option to point elsewhere.
+Results appear in the jobs list ("Web research · TinyFish (external, metered)"), and "Read saved result" shows them. The result record holds the run id, source URL, observation time, the extracted items with their source URLs, and the source list.
+
+States shown: `not_configured`, `submitting`, `submission_unconfirmed`, `rejected`, `pending`, `running`, `status_unavailable`, `completed`, `completed_without_valid_result`, `failed`, `cancel_requested`, `cancellation_unconfirmed`, `cancelled` (shown as "Cancelled at TinyFish (as reported)") and `no_run_found`. An active run nobody has read for five minutes is labelled "not being followed".
+
+`checked: true` on a TinyFish task means schema-valid only. The result is untrusted page content and is not written to Ghoti memory.
+
+The result view goes through the existing `/api/runtime/result/<task>` route. A provider result carries URLs, which Ghoti's local-text filter refuses, so for a record with a `ghoti_provider_run/1` block the route checks instead that the text is at most 8000 characters, parses as `ghoti_web_research_result/1` and is bound to its task id.
+
+## Rollback
+- **Disable:** set `enabled: false` in the approval record, or delete the record and remove the environment variable. Existing run records stay readable.
+- **Remove the code:** revert the commit that added `tinyfish.py`, the `run_store.py` provider block, the `daily.js` labels, the registry entry and the `doctor.py` name. No data migration is involved.
+- **Live runs:** before disabling, `cancel` any active run and confirm the provider reports CANCELLED. Otherwise check the TinyFish dashboard.
+
+## Attribution
+TinyFish is a third-party service (tinyfish.ai). This adapter is first-party Ghoti code written against TinyFish's public HTTP API documentation; no TinyFish source is copied, and no SDK is vendored. Use of the service is subject to TinyFish's terms and pricing.
