+
+    def test_queue_authority_refuses_each_defect(self):
+        def setp(*keys, value):
+            def mutate(record):
+                target = record
+                for k in keys[:-1]:
+                    target = target[k]
+                target[keys[-1]] = value
+            return mutate
+        cases = {
+            "wrong scope digest": dict(mutate=setp("request", "payload", "provider_scope_sha256", value="0" * 64)),
+            "missing capability": dict(mutate=setp("request", "capability_grant", "capabilities", value=["other.cap"])),
+            "revoked": dict(mutate=setp("request", "capability_grant", "revoked", value=True)),
+            "expired grant": dict(mutate=setp("request", "capability_grant", "expires_at", value="1970-01-02T00:00:00Z")),
+            "tampered token": dict(mutate=setp("request", "approval_token_hash", value="0" * 64)),
+            "rejected present": dict(extra_state="rejected"),
+            "non-req id": dict(rid="approval-tinyfish-test"),
+        }
+        for label, kwargs in cases.items():
+            with self.subTest(label):
+                self.queue_env(**kwargs)
+                self.assertEqual(self.tf.readiness()["state"], "not_configured")
+                self.assertEqual(self.tf.start(URL, QUESTION)["status"], "NOT_CONFIGURED")
+                self.assertEqual(self.fake.posts, [])
+
+    def test_real_transport_defaults_to_the_queue_authority(self):
+        self.env()
+        real = tinyfish.TinyFish(self.store, api_key=KEY)  # constructs HttpTransport; sends nothing
+        self.assertIsInstance(real.authority, tinyfish.QueueAuthority)
+        self.assertIsInstance(real.transport, tinyfish.HttpTransport)
+        self.assertIsNone(self.tf.authority, "an injected fake transport without an authority skips the queue check")
+
+    # -- g: persistence-boundary redaction
+    def test_key_echoed_by_provider_never_reaches_any_persisted_file(self):
+        self.env(Fake(start=[resp(400, {"error": {"message": f"bad key {KEY}"}})]))
+        self.assertEqual(self.tf.start(URL, QUESTION)["status"], "REJECTED")
+        files = self.assert_no_secret_on_disk(KEY)
+        self.assertTrue(any(tinyfish.INDEX_DIR.split("/")[0] in p.parts for p in files))
+
+        leaky = {"summary": f"Summary mentioning {KEY}", "items": [
+            {"name": f"Feature {KEY}", "detail": f"Uses key {KEY}", "source_url": "https://docs.tinyfish.ai/a"}]}
+        task = self.started()
+        self.fake.queues["get"] = [completed(result=leaky)]
+        self.assertEqual(self.tf.poll(task)["status"], "COMPLETED")
+        self.assertTrue(self.output_path(task).exists())
+        files = self.assert_no_secret_on_disk(KEY)
+        self.assertIn(self.output_path(task), files)
+        self.assertIn(self.store.path(f"{tinyfish.INDEX_DIR}/{task}.json"), files)
+        self.assertIn("***", self.store.read(f"ghoti_runtime_runs/{task}.output.json")["text"])
+
+    def test_key_shaped_question_text_is_not_persisted(self):
+        for question in ("List features with api_key=SECRETVALUE123", "List features; header X-API-Key SECRETVALUE123"):
+            with self.subTest(question=question):
+                self.env(Fake(start=[resp(200, {"run_id": "run_1"})]))
+                try:
+                    self.tf.start(URL, question)
+                except ValueError:
+                    pass  # refused before anything is recorded is also acceptable
+                for path, data in self.all_store_bytes():
+                    self.assertNotIn(b"SECRETVALUE123", data, f"key-shaped text persisted in {path}")
+        # the second form passes input validation, so the redaction itself is exercised
+        self.assertEqual(len(self.fake.posts), 1)
+
+    # -- h: result route contract
+    def test_check_provider_result_accepts_a_real_run_and_refuses_each_defect(self):
+        task = self.started("run_route")
+        self.fake.queues["get"] = [completed("run_route")]
+        self.tf.poll(task)
+        record = self.record(task)
+        payload = self.store.read(f"ghoti_runtime_runs/{task}.output.json")
+        import hashlib
+        sha = hashlib.sha256
+        self.assertEqual(tinyfish.check_provider_result(task, record, payload)["schema"], "ghoti_web_research_result/1")
+
+        def with_text(text):
+            def fn(rec, pay):
+                pay["text"] = text
+                pay["sha256"] = sha(text.encode()).hexdigest()
+            return fn
+
+        def with_result(**changes):
+            def fn(rec, pay):
+                result = json.loads(pay["text"])
+                result.update(changes)
+                with_text(json.dumps(result))(rec, pay)
+            return fn
+
+        cases = {
+            "text is a list": with_text("[1]"),
+            "text is null": with_text("null"),
+            "text is a string": with_text('"s"'),
+            "wrong provider name": (lambda r, p: r["provider"].__setitem__("provider", "other")),
+            "provider state not completed": (lambda r, p: r["provider"].__setitem__("state", "running")),
+            "task operation changed": (lambda r, p: r["task"].__setitem__("operation", "other_op")),
+            "run_id mismatch in result": with_result(run_id="run_other"),
+            "sha256 mismatch": (lambda r, p: p.__setitem__("sha256", "0" * 64)),
+            "payload task_id mismatch": (lambda r, p: p.__setitem__("task_id", "task-other")),
+            "output_paths mismatch": (lambda r, p: r["task"]["result"].__setitem__(
+                "output_paths", ["ghoti_runtime_runs/task-other.output.json"])),
+            "text over 8000 chars": with_result(pad="x" * 8100),
+        }
+        for label, fn in cases.items():
+            with self.subTest(label):
+                rec, pay = copy.deepcopy(record), copy.deepcopy(payload)
+                fn(rec, pay)
+                with self.assertRaises(ValueError):
+                    tinyfish.check_provider_result(task, rec, pay)
+        for label, bad_payload in (("list", [payload]), ("string", "x"), ("none", None)):
+            with self.subTest(f"payload not a dict: {label}"):
+                with self.assertRaises(ValueError):
+                    tinyfish.check_provider_result(task, copy.deepcopy(record), bad_payload)
+
