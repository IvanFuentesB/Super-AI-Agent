+def scope_sha256(cfg: dict) -> str:
+    """Digest of what the owner approved; a queue grant must carry exactly this to authorise it."""
+    scope = {k: cfg[k] for k in ("max_duration_seconds", "local_deadline_seconds", "max_concurrent_runs",
