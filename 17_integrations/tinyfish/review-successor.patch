+class ReviewFollowUps(Base):
+    """Regressions for the review follow-ups: durable provider index, approval-queue authority,
+    persistence-boundary redaction and the result route's provider-record contract."""
+
+    QUEUE_ID = "req-tinyfish-test01"
+    FINGERPRINT = "fp-synthetic-0001"
+    GRANT_ID = "grant-tinyfish-test01"
+    GRANT_EXPIRES = "2099-01-01T00:00:00Z"
+
+    # -- helpers
+    def add_unrelated_jobs(self, count=120):
+        from ghoti_runtime.contracts import Task
+        for i in range(count):
+            created = f"2999-01-01T00:{i // 60:02}:{i % 60:02}+00:00"  # later than every TinyFish record
+            self.store.save_task(Task(task_id=f"task-unrelated-{i:03}", title="Unrelated", intent="local",
+                                      created_at=created, created_by="test:local"))
+
+    def assert_outside_recent_window(self, task_id):
+        self.assertNotIn(task_id, [r["task"]["task_id"] for r in self.store.recent(100)],
+                         "precondition: the TinyFish record must be outside the jobs list's recent window")
+
+    def token(self, rid=None):
+        rid = rid or self.QUEUE_ID
+        import hashlib
+        return hashlib.sha256(f"explicit-local-approval:{rid}:{self.FINGERPRINT}".encode()).hexdigest()
+
+    def queue_record(self, rid=None):
+        rid = rid or self.QUEUE_ID
+        token = self.token(rid)
+        scope = tinyfish.scope_sha256(tinyfish.load_config(self.store, self.clock))
+        return {"request": {"request_id": rid, "approval_state": "approved", "approval_token_hash": token,
+                            "grant_id": self.GRANT_ID, "payload": {"provider_scope_sha256": scope},
+                            "capability_grant": {"schema": "ghoti_capability_grant/1", "grant_id": self.GRANT_ID,
+                                                 "revoked": False, "approval": {"approved": True, "token_hash": token},
+                                                 "expires_at": self.GRANT_EXPIRES,
+                                                 "capabilities": [tinyfish.GRANT_CAPABILITY],
+                                                 "targets": [tinyfish.GRANT_TARGET]}},
+                "guard_decision": {"allow": True, "request_fingerprint": self.FINGERPRINT}}
+
+    def queue_env(self, mutate=None, rid=None, write=True, extra_state=None):
+        """Fresh env whose adapter verifies a synthetic approval queue under the test root."""
+        rid = rid or self.QUEUE_ID
+        self.env(Fake(start=[resp(200, {"run_id": "run_q"})]), approval_request_id=rid)
+        qroot = self.store.root / "approval_queue"
+        if write:
+            record = self.queue_record(rid)
+            if mutate:
+                mutate(record)
+            (qroot / "approved").mkdir(parents=True, exist_ok=True)
+            (qroot / "approved" / f"{rid}.json").write_text(json.dumps(record), encoding="utf-8")
+        if extra_state:
+            (qroot / extra_state).mkdir(parents=True, exist_ok=True)
+            (qroot / extra_state / f"{rid}.json").write_text("{}", encoding="utf-8")
+        self.tf = tinyfish.TinyFish(self.store, transport=self.fake, api_key=KEY, clock=self.clock,
+                                    sleep=self.clock.sleep, authority=tinyfish.QueueAuthority(qroot))
+        return self.tf
+
+    def assert_no_secret_on_disk(self, secret):
+        files = list(self.all_store_bytes())
+        self.assertTrue(files)
+        for path, data in files:
+            self.assertNotIn(secret.encode(), data, f"{secret!r} persisted in {path}")
+        return [p for p, _ in files]
