+
+        again = self.tf.start(URL, QUESTION)
+        self.assertEqual(again["status"], "DUPLICATE_REFUSED")
+        self.assertEqual(again["task_id"], task)
+        self.assertEqual(len(self.fake.posts), 1)
+        self.assertEqual(record.read_bytes(), original)
+
+    def test_legacy_and_indexed_runs_share_one_daily_limit(self):
+        self.env(Fake(start=[resp(200, {"run_id": "run_1"}), resp(200, {"run_id": "run_2"})]),
+                 max_runs_per_day=2, max_concurrent_runs=2)
+        legacy = self.tf.start(URL, QUESTION)["task_id"]
+        self.store.path(f"{tinyfish.INDEX_DIR}/{legacy}.json").unlink()
