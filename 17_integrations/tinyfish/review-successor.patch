+    def test_indexed_run_without_a_readable_record_blocks_new_starts(self):
+        for label in ("missing", "unreadable"):
+            with self.subTest(label):
+                task = self.started()
+                self.fake.queues["get"] = [completed()]
+                self.tf.poll(task)  # terminal: without the strict index check a new start would be accepted
+                self.assertTrue(self.store.path(f"{tinyfish.INDEX_DIR}/{task}.json").is_file())
