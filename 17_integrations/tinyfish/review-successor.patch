+    # -- a..d: durable provider index
+    def test_unconfirmed_run_still_refuses_duplicate_and_busy_after_120_unrelated_jobs(self):
+        self.env(Fake(start=[tinyfish.TransportError("Timeout")]))
+        task = self.tf.start(URL, QUESTION)["task_id"]
