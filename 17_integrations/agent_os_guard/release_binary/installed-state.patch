@@ -0,0 +1,49 @@
+"""Agent OS mutable state: the repository in a checkout, Ghoti's runtime root in an installed release."""
+import importlib.util
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+spec = importlib.util.spec_from_file_location("state_root_under_test", REPO_ROOT / "03_scripts/agent_os/state_root.py")
+sr = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(sr)
+
+
+class StateRoot(unittest.TestCase):
+    def release(self, tmp):
+        release = Path(tmp) / "Ghoti" / "releases" / ("a" * 40)
+        (release / "03_scripts").mkdir(parents=True)
+        (release / "release.json").write_text("{}", encoding="utf-8")
+        return release
+
+    def test_a_checkout_keeps_its_state_in_the_repository(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.dict(os.environ, {"GHOTI_RUNTIME_ROOT": tmp}):
+            self.assertEqual(sr.state_root(REPO_ROOT), REPO_ROOT.resolve())
+
+    def test_a_release_uses_the_runtime_root_the_entry_sets(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            release = self.release(tmp)
+            runtime = Path(tmp) / "elsewhere" / "runtime"
+            with patch.dict(os.environ, {"GHOTI_RUNTIME_ROOT": str(runtime)}):
+                self.assertEqual(sr.state_root(release), runtime.resolve())
+
+    def test_a_release_without_the_variable_uses_its_installation_runtime(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.dict(os.environ, {}, clear=False):
+            os.environ.pop("GHOTI_RUNTIME_ROOT", None)
+            release = self.release(tmp)
+            self.assertEqual(sr.state_root(release), (Path(tmp) / "Ghoti" / "runtime").resolve())
+
+    def test_state_inside_the_release_is_refused(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            release = self.release(tmp)
+            for inside in (release, release / "14_context"):
+                with self.subTest(inside), patch.dict(os.environ, {"GHOTI_RUNTIME_ROOT": str(inside)}):
+                    with self.assertRaises(ValueError):
+                        sr.state_root(release)
+
+
+if __name__ == "__main__":
+    unittest.main()
