diff --git a/03_scripts/agent_os/state_root.py b/03_scripts/agent_os/state_root.py
new file mode 100644
index 0000000000000000000000000000000000000000..f4443fc5723a2fdb39d26a8a04bd12fbf7646891
--- /dev/null
+++ b/03_scripts/agent_os/state_root.py
@@ -0,0 +1,34 @@
+"""Where Agent OS mutable state (approval queue, workflow artifacts, run records, evidence, handoffs) lives.
+
+Development checkout: the repository itself, unchanged.
+
+Installed release (a ``release.json`` beside ``03_scripts``): the release is immutable and every file is
+hash-checked, so mutable state goes to Ghoti's runtime root instead: ``GHOTI_RUNTIME_ROOT`` as
+``current/ghoti.py`` and the supervisor set it, else ``<install>/runtime`` derived the same way from
+``<install>/releases/<commit>``. The state root mirrors the repository layout (as ``ghoti_runtime.paths``
+does for generated state), so every repo-relative path, path restriction and guard decision is unchanged.
+Reads of released content (templates, memory pointers, the guard) stay on the release.
+"""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+RELEASE_ROOT = Path(__file__).resolve().parents[2]
+RUNTIME_ROOT_ENV_VAR = "GHOTI_RUNTIME_ROOT"
+
+
+def installed(root: Path = RELEASE_ROOT) -> bool:
+    return (Path(root) / "release.json").is_file()
+
+
+def state_root(root: Path = RELEASE_ROOT) -> Path:
+    root = Path(root).resolve()
+    if not installed(root):
+        return root
+    raw = os.environ.get(RUNTIME_ROOT_ENV_VAR, "").strip()
+    base = (Path(raw) if raw else root.parents[1] / "runtime").resolve()
+    if base == root or base.is_relative_to(root):
+        raise ValueError("Agent OS state must live outside the immutable release")
+    return base
