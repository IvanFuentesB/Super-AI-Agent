+/// Reads at most `limit` bytes of UTF-8 text. The read itself is bounded (`limit + 1` bytes at most), so a file
+/// that is larger, still growing, or not a regular file is refused as oversized without being read whole.
+fn read_bounded(path: &Path, limit: u64, what: &str) -> Result<String, String> {
+    let file = fs::File::open(path).map_err(|error| format!("could not read {what}: {error}"))?;
+    let mut bytes = Vec::new();
+    file.take(limit + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|error| format!("could not read {what}: {error}"))?;
+    if bytes.len() as u64 > limit {
+        return Err(format!(
+            "{what} is oversized: it exceeds the {limit}-byte limit; refused without parsing"
+        ));
+    }
+    String::from_utf8(bytes).map_err(|_| format!("{what} is not valid UTF-8"))
+}
