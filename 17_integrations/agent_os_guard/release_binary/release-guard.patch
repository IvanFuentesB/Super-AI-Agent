+def invoke(args: list[str], *, root: Path = REPO_ROOT, timeout: int = 180, executable: Path | None = None) -> dict:
+    """Run the guard with ``args``; its JSON decision, or a structured refusal. Never raises for a
+    guard that is missing, invalid, unlaunchable, slow or failing. ``executable`` (an explicit
+    binary that exists, as tests pass it) replaces resolution."""
