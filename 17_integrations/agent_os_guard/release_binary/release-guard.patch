index 0000000000000000000000000000000000000000..a4caf6ca20a6a1d2d0e96540ad2fc6621aa2bc57
--- /dev/null
+++ b/01_projects/runtime_mvp/tests/test_agent_os_guard_release_binary.py
@@ -0,0 +1,127 @@
+"""The packaged Agent OS guard: release allowlist, installed-route resolution and structured refusals.
+Local fixtures only; no clones, installs, Cargo or network."""
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO_ROOT / "03_scripts"))
+from ghoti_runtime import deployment as dep  # noqa: E402
+
+spec = importlib.util.spec_from_file_location("guard_binary_under_test", REPO_ROOT / "03_scripts/agent_os/guard_binary.py")
+gb = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(gb)
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+class ReleaseAllowlist(unittest.TestCase):
+    def test_only_the_reviewed_guard_executable_enters_a_release(self):
+        self.assertTrue(dep._included(gb.PACKAGED))
+        self.assertTrue(dep._included(gb.PROVENANCE))
+        for other in ("03_scripts/agent_os/bin/other.exe", "03_scripts/agent_os/agent_os_guard.exe",
+                      "03_scripts/ghoti.exe", "rust/target/release/agent_os_guard.exe"):
+            with self.subTest(other):
+                self.assertFalse(dep._included(other))
+
+
+class PackagedBinary(unittest.TestCase):
+    """The committed executable is the pinned one and is the 0.6.0 guard."""
+
+    def test_committed_executable_matches_its_pin_and_runs(self):
+        binary = REPO_ROOT / gb.PACKAGED
+        record = json.loads((REPO_ROOT / gb.PROVENANCE).read_text(encoding="utf-8"))
+        self.assertEqual(sha(binary.read_bytes()), record["sha256"])
+        self.assertEqual(binary.stat().st_size, record["bytes"])
+        decision = gb.invoke(["--check"], executable=binary)
+        self.assertEqual(decision.get("guard_version"), record["guard_version"])
+        self.assertIs(decision.get("allow"), True)
+
+
+class InstalledRoute(unittest.TestCase):
+    """A release layout: release.json beside 03_scripts. Only the packaged, pinned, manifest-bound bytes run."""
+
+    def layout(self, root, binary=b"MZ guard bytes", manifest_digest=None, pin=None, packaged=True):
+        files = {"03_scripts/ghoti.py": sha(b"# entry")}
+        (root / "03_scripts").mkdir(parents=True)
+        (root / "03_scripts/ghoti.py").write_bytes(b"# entry")
+        if packaged:
+            path = root / gb.PACKAGED
+            path.parent.mkdir(parents=True)
+            path.write_bytes(binary)
+            files[gb.PACKAGED] = manifest_digest or sha(binary)
+            provenance = json.dumps({"sha256": pin or sha(binary)}).encode()
+            (root / gb.PROVENANCE).write_bytes(provenance)
+            files[gb.PROVENANCE] = sha(provenance)
+        (root / "release.json").write_text(json.dumps({"commit": "a" * 40, "files": files}), encoding="utf-8")
+
+    def resolve(self, **kw):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            self.layout(root, **kw)
+            return gb.resolve(root), root
+
+    def test_the_bound_packaged_executable_is_the_only_route(self):
+        target, root = self.resolve()
+        self.assertEqual(target["route"], "release")
+        self.assertEqual(target["argv"], [str(root / gb.PACKAGED)])
+
+    def test_development_overrides_are_ignored_in_a_release(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.dict(os.environ, {"GHOTI_AGENT_OS_GUARD_BINARY": sys.executable}), \
+                patch.object(gb.shutil, "which", return_value=sys.executable):
+            root = Path(tmp)
+            self.layout(root, packaged=False)
+            (root / "rust/target/release").mkdir(parents=True)
+            (root / "rust/target/release/agent_os_guard.exe").write_bytes(b"dev build")
+            (root / "rust/Cargo.toml").write_text("[workspace]\n")
+            self.assertEqual(gb.resolve(root)["reason"], "rust_guard_unavailable")
+
+    def test_bytes_that_differ_from_the_manifest_or_the_pin_are_refused(self):
+        for kw in ({"manifest_digest": "0" * 64}, {"pin": "0" * 64}):
+            with self.subTest(kw):
+                target, _ = self.resolve(**kw)
+                self.assertEqual(target["reason"], "rust_guard_binary_invalid")
+                self.assertFalse(target["allow"])
+
+    def test_a_release_without_the_guard_is_unavailable(self):
+        target, _ = self.resolve(packaged=False)
+        self.assertEqual(target, gb.refusal("rust_guard_unavailable", "this release does not package agent_os_guard.exe"))
+
+
+class Refusals(unittest.TestCase):
+    """invoke() never raises: every failure is a structured denial."""
+
+    def run_with(self, code, timeout=30):
+        return gb.invoke(["-c", code], executable=Path(sys.executable), timeout=timeout)
+
+    def test_non_zero_exit_timeout_and_non_json_output_are_denials(self):
+        cases = {"exit": ("import sys; sys.stderr.write('boom'); sys.exit(3)", "boom"),
+                 "not json": ("print('hello')", "not a JSON object"),
+                 "json list": ("print('[1]')", "not a JSON object"),
+                 "timeout": ("import time; time.sleep(10)", "TimeoutExpired")}
+        for name, (code, expect) in cases.items():
+            with self.subTest(name):
+                result = self.run_with(code, timeout=2 if name == "timeout" else 30)
+                self.assertEqual(result["reason"], "rust_guard_invocation_failed")
+                self.assertIn(expect, result["error"])
+                self.assertFalse(result["allow"])
+
+    def test_an_executable_that_cannot_launch_is_a_denial(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            fake = Path(tmp) / "agent_os_guard.exe"
+            fake.write_text("not an executable", encoding="utf-8")
+            result = gb.invoke(["--check"], executable=fake)
+        self.assertEqual(result["reason"], "rust_guard_invocation_failed")
+        self.assertIn("OSError", result["error"])
+
+
+if __name__ == "__main__":
+    unittest.main()
