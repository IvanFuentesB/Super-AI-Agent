@@ -0,0 +1,110 @@
+"""Which agent_os_guard executable runs, and how any failure becomes a structured refusal.
+
+Installed release (a ``release.json`` beside ``03_scripts``): only the packaged executable
+``03_scripts/agent_os/bin/agent_os_guard.exe``, and only when its bytes equal both its entry in the
+release manifest and the reviewed pin in ``agent_os_guard.provenance.json``. No environment
+override, development ``rust/target`` directory or Cargo is consulted, so the installed route does
+not depend on a development checkout or a Rust toolchain.
+
+Development checkout (no ``release.json``): the existing order, unchanged:
+``GHOTI_AGENT_OS_GUARD_BINARY``, ``rust/target/{release,debug}``, then ``cargo run``.
+
+Refusals (``allow: False``, ``decision: "denied"``):
+  rust_guard_unavailable        no executable for this route
+  rust_guard_binary_invalid     the packaged bytes differ from the release manifest or the pin
+  rust_guard_invocation_failed  cannot launch, timed out, non-zero exit, or output that is not a JSON object
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+PACKAGED = "03_scripts/agent_os/bin/agent_os_guard.exe"
+PROVENANCE = "03_scripts/agent_os/bin/agent_os_guard.provenance.json"
+_MAX_RECORD_BYTES = 2_000_000
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _record(path: Path) -> dict:
+    if not path.is_file() or path.stat().st_size > _MAX_RECORD_BYTES:
+        return {}
+    value = json.loads(path.read_text(encoding="utf-8"))
+    return value if isinstance(value, dict) else {}
+
+
+def refusal(reason: str, error: str | None = None) -> dict:
+    result = {"allow": False, "decision": "denied", "reason": reason, "reasons": [reason]}
+    if error:
+        result["error"] = error[-500:]
+    return result
+
+
+def resolve(root: Path = REPO_ROOT) -> dict:
+    """``{"argv": [...], "route": ..., "sha256": ...}`` for the executable to run, or a refusal."""
+    root = Path(root)
+    if (root / "release.json").is_file():
+        try:
+            files = _record(root / "release.json").get("files", {})
+            digest = files.get(PACKAGED) if isinstance(files, dict) else None
+            binary = root / PACKAGED
+            if not digest or not binary.is_file():
+                return refusal("rust_guard_unavailable", "this release does not package agent_os_guard.exe")
+            pin = _record(root / PROVENANCE).get("sha256")
+            actual = _sha256(binary)
+        except (OSError, ValueError) as error:
+            return refusal("rust_guard_binary_invalid", f"{type(error).__name__}: {error}")
+        if actual != digest or actual != pin:
+            return refusal("rust_guard_binary_invalid",
+                           f"packaged guard {actual} differs from the release manifest or the reviewed pin")
+        return {"argv": [str(binary)], "route": "release", "sha256": actual}
+    configured = os.environ.get("GHOTI_AGENT_OS_GUARD_BINARY")
+    candidates = [
+        Path(configured) if configured else None,
+        root / "rust" / "target" / "release" / "agent_os_guard.exe",
+        root / "rust" / "target" / "release" / "agent_os_guard",
+        root / "rust" / "target" / "debug" / "agent_os_guard.exe",
+        root / "rust" / "target" / "debug" / "agent_os_guard",
+    ]
+    binary = next((candidate for candidate in candidates if candidate and candidate.is_file()), None)
+    if binary:
+        return {"argv": [str(binary)], "route": "development-binary", "sha256": None}
+    cargo = shutil.which("cargo")
+    if cargo and (root / "rust" / "Cargo.toml").is_file():
+        return {"argv": [cargo, "run", "--quiet", "--manifest-path", str(root / "rust" / "Cargo.toml"),
