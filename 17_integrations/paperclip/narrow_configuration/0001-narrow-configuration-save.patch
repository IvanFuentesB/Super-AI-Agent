+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import type { Agent } from "@paperclipai/shared";
+import { expect, it, vi } from "vitest";
+import { AgentConfigForm } from "./AgentConfigForm";
+import { TooltipProvider } from "./ui/tooltip";
+
+vi.mock("../context/CompanyContext", () => ({ useCompany: () => ({ selectedCompanyId: null }) }));
+vi.mock("../adapters", () => ({ getUIAdapter: () => ({ buildAdapterConfig: () => ({}), ConfigFields: () => null }) }));
+vi.mock("../adapters/use-disabled-adapters", () => ({ useDisabledAdaptersSync: () => new Set() }));
+vi.mock("../adapters/use-adapter-capabilities", () => ({ useAdapterCapabilities: () => () => ({ supportsLocalAgentJwt: true }) }));
+vi.mock("../api/instanceSettings", () => ({ instanceSettingsApi: { getGeneral: async () => ({}) } }));
+vi.mock("./MarkdownEditor", () => ({ MarkdownEditor: () => null }));
+vi.mock("./PathInstructionsModal", () => ({ ChoosePathButton: () => null }));
+vi.mock("./EnvVarEditor", () => ({ EnvVarEditor: () => null }));
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const OLD_TOOLS = "Read,Glob,Grep,Bash(curl *http://127.0.0.1:41402/*)";
+const NEW_TOOLS = "Read,Glob,Grep,Bash(curl *$PAPERCLIP_API_URL/api/*)";
+
+function makeAgent(): Agent {
+  return {
+    id: "agent-ceo",
+    companyId: "company-1",
+    name: "CEO",
+    role: "ceo",
+    title: "CEO",
+    icon: null,
+    status: "active",
+    reportsTo: null,
+    capabilities: null,
+    adapterType: "claude_local",
+    adapterConfig: {
+      model: "claude-sonnet-4-6",
+      cwd: "C:/synthetic/workspace",
+      dangerouslySkipPermissions: false,
+      instructionsFilePath: "C:/synthetic/instructions/AGENTS.md",
+      env: { SYNTHETIC_TOKEN: { type: "plain", value: "synthetic-secret-value" } },
+      extraArgs: ["--allowedTools", OLD_TOOLS],
+    },
+    runtimeConfig: { heartbeat: { enabled: true, intervalSec: 300 } },
+    budgetMonthlyCents: 5000,
+    spentMonthlyCents: 0,
+    pauseReason: null,
+    pausedAt: null,
+    lastHeartbeatAt: null,
+    createdAt: new Date("2026-01-01T00:00:00.000Z"),
+    updatedAt: new Date("2026-01-01T00:00:00.000Z"),
+    urlKey: "ceo",
+    permissions: { canCreateAgents: false },
+    metadata: null,
+  };
+}
+
+it("saves an edited extra-args value as a merge patch holding only that field", async () => {
+  const onSave = vi.fn();
+  let save: (() => void) | null = null;
+  const onSaveActionChange = (action: (() => void) | null) => { save = action; };
+  const agent = makeAgent();
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  const node = document.createElement("div"); document.body.append(node);
+  const root = createRoot(node);
+  try {
+    await act(async () => root.render(
+      <QueryClientProvider client={client}><TooltipProvider>
+        <AgentConfigForm mode="edit" agent={agent} onSave={onSave} onSaveActionChange={onSaveActionChange} />
+      </TooltipProvider></QueryClientProvider>,
+    ));
+    const label = [...node.querySelectorAll("label")].find((el) => el.textContent === "Extra args (comma-separated)");
+    expect(label, "missing extra args field").toBeDefined();
+    const input = label!.parentElement!.parentElement!.querySelector("input")!;
+    async function type(value: string) {
+      await act(async () => {
+        Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!.call(input, value);
+        input.dispatchEvent(new Event("input", { bubbles: true }));
+      });
+    }
+
+    // The comma-containing argument is shown quoted, so it can be edited in place.
+    expect(input.value).toBe(`--allowedTools, "${OLD_TOOLS}"`);
+
+    // Nothing edited: the save action sends nothing.
+    await act(async () => save!());
+    expect(onSave).not.toHaveBeenCalled();
+
+    // Text typed into the field stays as typed, commas included.
+    await type('--allowedTools, "Read,Glob');
+    expect(input.value).toBe('--allowedTools, "Read,Glob');
+
+    await type(`--allowedTools, "${NEW_TOOLS}"`);
+    expect(input.value).toBe(`--allowedTools, "${NEW_TOOLS}"`);
+
+    await act(async () => save!());
+    expect(onSave).toHaveBeenCalledTimes(1);
+    expect(onSave.mock.calls[0]![0]).toEqual({
+      adapterConfig: { extraArgs: ["--allowedTools", NEW_TOOLS] },
+      replaceAdapterConfig: false,
+    });
+  } finally {
+    await act(async () => root.unmount()); node.remove(); client.clear();
+  }
+});
