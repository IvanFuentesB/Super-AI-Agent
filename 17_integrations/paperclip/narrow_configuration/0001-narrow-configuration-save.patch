+++ b/server/src/__tests__/agent-config-narrow-save-routes.test.ts
@@ -0,0 +1,355 @@
+import type { Server } from "node:http";
+import express from "express";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Agent } from "@paperclipai/shared";
+import { agentsApi } from "../../../ui/src/api/agents.js";
+import {
+  assertNoRedactedValues,
+  buildAgentUpdatePatch,
+  isUncertainSaveFailure,
+  type AgentConfigOverlay,
+} from "../../../ui/src/lib/agent-config-patch.js";
+
+// The UI's Configuration Save (patch builder + API client) driven against the
+// real PATCH /api/agents/:id handler and board mutation guard. Synthetic data only.
+
+const mockAgentService = vi.hoisted(() => ({
+  getById: vi.fn(),
+  update: vi.fn(),
+  resolveByReference: vi.fn(),
+  getChainOfCommand: vi.fn(async () => []),
+}));
+const mockAccessService = vi.hoisted(() => ({
+  canUser: vi.fn(),
+  hasPermission: vi.fn(),
+  getMembership: vi.fn(async () => null),
+  listPrincipalGrants: vi.fn(async () => []),
+}));
+const mockSecretService = vi.hoisted(() => ({
+  resolveAdapterConfigForRuntime: vi.fn(),
+  normalizeAdapterConfigForPersistence: vi.fn(async (_companyId: string, config: Record<string, unknown>) => config),
+}));
+const mockLogActivity = vi.hoisted(() => vi.fn());
+const mockSyncInstructionsBundleConfigFromFilePath = vi.hoisted(() => vi.fn());
+
+function registerModuleMocks() {
+  vi.doMock("../services/index.js", () => ({
+    agentService: () => mockAgentService,
+    agentInstructionsService: () => ({}),
+    accessService: () => mockAccessService,
+    approvalService: () => ({}),
+    companySkillService: () => ({ listRuntimeSkillEntries: vi.fn() }),
+    budgetService: () => ({}),
+    environmentService: () => ({ getById: vi.fn() }),
+    heartbeatService: () => ({}),
+    issueApprovalService: () => ({}),
+    issueService: () => ({}),
+    logActivity: mockLogActivity,
+    secretService: () => mockSecretService,
+    syncInstructionsBundleConfigFromFilePath: mockSyncInstructionsBundleConfigFromFilePath,
+    workspaceOperationService: () => ({}),
+  }));
+  vi.doMock("../adapters/index.js", () => ({
+    findServerAdapter: (type: string) => ({ type }),
+    listAdapterModels: vi.fn(),
+  }));
+}
+
+const CEO_ID = "11111111-1111-4111-8111-111111111111";
+const OTHER_AGENT_ID = "22222222-2222-4222-8222-222222222222";
+const OLD_TOOLS = "Read,Glob,Grep,Bash(curl *http://127.0.0.1:41402/*)";
+const NEW_TOOLS = "Read,Glob,Grep,Bash(curl *$PAPERCLIP_API_URL/api/*)";
+const NEW_EXTRA_ARGS = ["--allowedTools", NEW_TOOLS];
+
+function makeStoredAgent() {
+  return {
+    id: CEO_ID,
+    companyId: "company-1",
+    name: "CEO",
+    role: "ceo",
+    title: "Chief Executive",
+    status: "active",
+    reportsTo: null,
+    capabilities: null,
+    adapterType: "claude_local",
+    adapterConfig: {
+      model: "claude-sonnet-4-6",
+      cwd: "C:/synthetic/workspace",
+      dangerouslySkipPermissions: false,
+      instructionsFilePath: "C:/synthetic/instructions/AGENTS.md",
+      env: {
+        SYNTHETIC_PLAIN: { type: "plain", value: "synthetic-secret-value" },
+        SYNTHETIC_REF: { type: "secret_ref", secretId: "33333333-3333-4333-8333-333333333333", version: "latest" },
+      },
+      extraArgs: ["--allowedTools", OLD_TOOLS],
+    } as Record<string, unknown>,
+    runtimeConfig: { heartbeat: { enabled: true, intervalSec: 300 } },
+    budgetMonthlyCents: 5000,
+    spentMonthlyCents: 120,
+    defaultEnvironmentId: null,
+    permissions: { canCreateAgents: true },
+    updatedAt: new Date("2026-01-01T00:00:00.000Z"),
+  };
+}
+
+type Actor = Record<string, unknown>;
+const boardSession = (extra: Actor = {}): Actor => ({
+  type: "board",
+  userId: "synthetic-user",
+  companyIds: ["company-1"],
+  source: "session",
+  isInstanceAdmin: false,
+  ...extra,
+});
+
+function overlay(adapterConfig: Record<string, unknown>): AgentConfigOverlay {
+  return { identity: {}, adapterConfig, heartbeat: {}, runtime: {} };
+}
+
+/** What the browser's copy of the agent looks like: a JSON read of the stored record. */
+function uiCopy(agent: unknown): Agent {
+  return JSON.parse(JSON.stringify(agent)) as Agent;
+}
+
+describe("narrow Configuration Save against PATCH /api/agents/:id", () => {
+  let stored: ReturnType<typeof makeStoredAgent>;
+  let actor: Actor;
+  let server: Server;
+  let sentBodies: Array<Record<string, unknown>>;
+  let browserHeaders: Record<string, string>;
+  let failFetch: Error | null;
+
+  beforeEach(async () => {
+    vi.resetModules();
+    vi.doUnmock("../routes/agents.js");
+    vi.doUnmock("../routes/authz.js");
+    vi.doUnmock("../middleware/index.js");
+    registerModuleMocks();
+    vi.clearAllMocks();
+
+    stored = makeStoredAgent();
+    actor = boardSession();
+    sentBodies = [];
+    failFetch = null;
+    mockSyncInstructionsBundleConfigFromFilePath.mockImplementation((_agent, config) => config);
+    mockAccessService.canUser.mockResolvedValue(true);
+    mockAccessService.hasPermission.mockResolvedValue(false);
+    mockAgentService.getById.mockImplementation(async (id: string) => {
+      if (id === CEO_ID) return stored;
+      if (id === OTHER_AGENT_ID) return { ...makeStoredAgent(), id, role: "engineer", permissions: null };
+      return null;
+    });
+    mockAgentService.update.mockImplementation(async (_id: string, patch: Record<string, unknown>) => {
+      stored = { ...stored, ...patch } as typeof stored;
+      return stored;
+    });
+
+    const [{ agentRoutes }, { errorHandler }, { boardMutationGuard }] = await Promise.all([
+      vi.importActual<typeof import("../routes/agents.js")>("../routes/agents.js"),
+      vi.importActual<typeof import("../middleware/index.js")>("../middleware/index.js"),
+      vi.importActual<typeof import("../middleware/board-mutation-guard.js")>("../middleware/board-mutation-guard.js"),
+    ]);
+    const app = express();
+    app.use(express.json());
+    app.use((req, _res, next) => {
+      (req as any).actor = actor;
+      next();
+    });
+    app.use(boardMutationGuard());
+    app.use("/api", agentRoutes({} as any));
+    app.use(errorHandler);
+
+    const { createServer } = await vi.importActual<typeof import("node:http")>("node:http");
+    server = createServer(app);
+    await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+    const address = server.address();
+    if (!address || typeof address === "string") throw new Error("Expected a TCP port");
+    const baseUrl = `http://127.0.0.1:${address.port}`;
+    browserHeaders = { Origin: baseUrl };
+
+    // The UI client calls fetch("/api/..."); resolve it against the fixture server
+    // the way a browser on that origin would, including the Origin header.
+    const realFetch = globalThis.fetch;
+    vi.stubGlobal("fetch", async (input: string, init?: RequestInit) => {
+      if (failFetch) throw failFetch;
+      if (typeof init?.body === "string") sentBodies.push(JSON.parse(init.body));
+      const headers = new Headers(init?.headers);
+      for (const [name, value] of Object.entries(browserHeaders)) headers.set(name, value);
+      return realFetch(`${baseUrl}${input}`, { ...init, headers, credentials: undefined });
+    });
+  });
+
+  afterEach(async () => {
+    vi.unstubAllGlobals();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  });
+
+  /** The Configuration tab's save: guard, then the real API client. */
+  async function save(patch: Record<string, unknown>, agentId = CEO_ID) {
+    assertNoRedactedValues(patch);
+    return agentsApi.update(agentId, patch, "company-1");
+  }
+
+  it("changes only extraArgs and leaves every other stored field as it was", async () => {
+    const before = makeStoredAgent();
+    const patch = buildAgentUpdatePatch(uiCopy(stored), overlay({ extraArgs: NEW_EXTRA_ARGS }));
+
+    await save(patch);
+
+    expect(sentBodies).toEqual([{ adapterConfig: { extraArgs: NEW_EXTRA_ARGS }, replaceAdapterConfig: false }]);
+    expect(stored.adapterConfig).toEqual({ ...before.adapterConfig, extraArgs: NEW_EXTRA_ARGS });
+    expect(stored.adapterConfig.dangerouslySkipPermissions).toBe(false);
+    expect({ ...stored, adapterConfig: null }).toEqual({ ...before, adapterConfig: null });
+
+    // Only adapterConfig reaches the store, with the route's revision and audit records.
+    expect(mockAgentService.update).toHaveBeenCalledTimes(1);
+    const [id, storePatch, options] = mockAgentService.update.mock.calls[0]!;
+    expect(id).toBe(CEO_ID);
+    expect(Object.keys(storePatch)).toEqual(["adapterConfig"]);
+    expect(options).toEqual({
+      recordRevision: { createdByAgentId: null, createdByUserId: "synthetic-user", source: "patch" },
+    });
+    expect(mockLogActivity).toHaveBeenCalledWith(
+      expect.anything(),
+      expect.objectContaining({ action: "agent.updated", entityId: CEO_ID, actorType: "user", actorId: "synthetic-user" }),
+    );
+  });
+
+  it("does not write a stale browser copy over fields changed on the server meanwhile", async () => {
+    const staleCopy = uiCopy(stored);
+    stored.adapterConfig = {
+      ...stored.adapterConfig,
+      model: "claude-opus-4-6",
+      env: { SYNTHETIC_PLAIN: { type: "plain", value: "rotated-synthetic-value" } },
+    };
+
+    await save(buildAgentUpdatePatch(staleCopy, overlay({ extraArgs: NEW_EXTRA_ARGS })));
+
+    expect(stored.adapterConfig.model).toBe("claude-opus-4-6");
+    expect(stored.adapterConfig.env).toEqual({ SYNTHETIC_PLAIN: { type: "plain", value: "rotated-synthetic-value" } });
+    expect(stored.adapterConfig.extraArgs).toEqual(NEW_EXTRA_ARGS);
+  });
+
+  it("keeps stored secrets when the browser copy came from a redacted read", async () => {
+    const redactedCopy = uiCopy(stored);
+    (redactedCopy.adapterConfig as any).env.SYNTHETIC_PLAIN.value = "***REDACTED***";
+    const secretsBefore = makeStoredAgent().adapterConfig.env;
+
+    await save(buildAgentUpdatePatch(redactedCopy, overlay({ extraArgs: NEW_EXTRA_ARGS })));
+
+    expect(JSON.stringify(sentBodies)).not.toContain("REDACTED");
+    expect(stored.adapterConfig.env).toEqual(secretsBefore);
+  });
+
+  it("refuses to send a redacted placeholder as a value", async () => {
+    const redactedCopy = uiCopy(stored);
+    (redactedCopy.adapterConfig as any).env.SYNTHETIC_PLAIN.value = "***REDACTED***";
+    const before = makeStoredAgent();
+
+    // An edit of the env map itself, and a key removal (which still replaces the
+    // whole config from the browser copy), both carry the placeholder.
+    const envEdit = buildAgentUpdatePatch(redactedCopy, overlay({ env: (redactedCopy.adapterConfig as any).env }));
+    const keyRemoval = buildAgentUpdatePatch(redactedCopy, overlay({ extraArgs: undefined }));
+    expect(keyRemoval.replaceAdapterConfig).toBe(true);
+
+    await expect(save(envEdit)).rejects.toThrow("redacted placeholder");
+    await expect(save(keyRemoval)).rejects.toThrow("redacted placeholder");
+    expect(sentBodies).toEqual([]);
+    expect(mockAgentService.update).not.toHaveBeenCalled();
+    expect(stored).toEqual(before);
+  });
+
+  it("is rejected for a board user outside the company, and nothing is stored", async () => {
+    actor = boardSession({ companyIds: ["company-2"] });
+
+    const error = await save(buildAgentUpdatePatch(uiCopy(stored), overlay({ extraArgs: NEW_EXTRA_ARGS }))).catch((e) => e);
+
+    expect(error).toMatchObject({ status: 403, message: "User does not have access to this company" });
+    expect(isUncertainSaveFailure(error)).toBe(false);
+    expect(mockAgentService.update).not.toHaveBeenCalled();
+  });
+
+  it("is rejected for a board user without the agents:create permission, and for a viewer", async () => {
+    const patch = buildAgentUpdatePatch(uiCopy(stored), overlay({ extraArgs: NEW_EXTRA_ARGS }));
+
+    mockAccessService.canUser.mockResolvedValue(false);
+    await expect(save(patch)).rejects.toMatchObject({ status: 403, message: "Missing permission: agents:create" });
+
+    actor = boardSession({ memberships: [{ companyId: "company-1", status: "active", membershipRole: "viewer" }] });
+    await expect(save(patch)).rejects.toMatchObject({ status: 403, message: "Viewer access is read-only" });
+
+    expect(mockAgentService.update).not.toHaveBeenCalled();
+  });
+
+  it("is rejected without authentication", async () => {
+    actor = { type: "none", source: "none" };
+
+    const error = await save(buildAgentUpdatePatch(uiCopy(stored), overlay({ extraArgs: NEW_EXTRA_ARGS }))).catch((e) => e);
+
+    expect(error).toMatchObject({ status: 401 });
+    expect(isUncertainSaveFailure(error)).toBe(false);
+    expect(mockAgentService.update).not.toHaveBeenCalled();
+  });
+
+  it("is rejected for a session request that does not come from the board's own origin", async () => {
+    browserHeaders = { Origin: "http://attacker.invalid" };
+
+    const error = await save(buildAgentUpdatePatch(uiCopy(stored), overlay({ extraArgs: NEW_EXTRA_ARGS }))).catch((e) => e);
+
+    expect(error).toMatchObject({ status: 403, message: "Board mutation requires trusted browser origin" });
+    expect(mockAgentService.update).not.toHaveBeenCalled();
+  });
+
+  it("reports an unknown agent as not found", async () => {
+    const error = await save(
+      buildAgentUpdatePatch(uiCopy(stored), overlay({ extraArgs: NEW_EXTRA_ARGS })),
+      "99999999-9999-4999-8999-999999999999",
+    ).catch((e) => e);
+
+    expect(error).toMatchObject({ status: 404, message: "Agent not found" });
+    expect(mockAgentService.update).not.toHaveBeenCalled();
+  });
+
+  it("rejects permissions in the body and instruction-path changes from an agent key", async () => {
+    await expect(save({ adapterConfig: { extraArgs: NEW_EXTRA_ARGS }, permissions: { canCreateAgents: true } }))
+      .rejects.toMatchObject({ status: 400 });
+
+    actor = { type: "agent", agentId: CEO_ID, companyId: "company-1", source: "agent_key" };
+    await expect(save({ adapterConfig: { instructionsFilePath: "C:/synthetic/other.md" }, replaceAdapterConfig: false }))
+      .rejects.toMatchObject({ status: 403 });
+
+    actor = { type: "agent", agentId: OTHER_AGENT_ID, companyId: "company-1", source: "agent_key" };
+    await expect(save({ adapterConfig: { extraArgs: NEW_EXTRA_ARGS }, replaceAdapterConfig: false }))
+      .rejects.toMatchObject({ status: 403, message: "Only CEO or agent creators can modify other agents" });
+
+    expect(mockAgentService.update).not.toHaveBeenCalled();
+    expect(stored).toEqual(makeStoredAgent());
+  });
+
+  it("treats a lost connection as unconfirmed, and the readback decides whether to retry", async () => {
+    const patch = buildAgentUpdatePatch(uiCopy(stored), overlay({ extraArgs: NEW_EXTRA_ARGS }));
+
+    failFetch = new TypeError("Failed to fetch");
+    const error = await save(patch).catch((e) => e);
+    expect(isUncertainSaveFailure(error)).toBe(true);
+    expect(mockAgentService.update).not.toHaveBeenCalled();
+
+    // Readback shows the change is absent, so a single retry is correct.
+    failFetch = null;
+    expect((await agentsApi.get(CEO_ID, "company-1")).adapterConfig.extraArgs).toEqual(["--allowedTools", OLD_TOOLS]);
+    await save(patch);
+    expect((await agentsApi.get(CEO_ID, "company-1")).adapterConfig.extraArgs).toEqual(NEW_EXTRA_ARGS);
+    expect(mockAgentService.update).toHaveBeenCalledTimes(1);
+  });
+
+  it("treats a server error after the write as unconfirmed, and the readback shows it was applied", async () => {
+    mockLogActivity.mockRejectedValueOnce(new Error("synthetic audit failure"));
+
+    const error = await save(buildAgentUpdatePatch(uiCopy(stored), overlay({ extraArgs: NEW_EXTRA_ARGS }))).catch((e) => e);
+
+    expect(error).toMatchObject({ status: 500 });
+    expect(isUncertainSaveFailure(error)).toBe(true);
+    expect((await agentsApi.get(CEO_ID, "company-1")).adapterConfig.extraArgs).toEqual(NEW_EXTRA_ARGS);
+    expect(mockAgentService.update).toHaveBeenCalledTimes(1);
+  });
+});
