+// @vitest-environment node
+
+import { describe, expect, it } from "vitest";
+import { formatArgList, parseCommaArgs } from "./arg-list";
+
+describe("arg list", () => {
+  it("keeps plain comma-separated args as before", () => {
+    expect(parseCommaArgs("--verbose, --foo=bar")).toEqual(["--verbose", "--foo=bar"]);
+    expect(parseCommaArgs(" a ,, b ,")).toEqual(["a", "b"]);
+    expect(parseCommaArgs("")).toEqual([]);
+    expect(formatArgList(["--verbose", "--foo=bar"])).toBe("--verbose, --foo=bar");
+    expect(formatArgList("--verbose")).toBe("--verbose");
+    expect(formatArgList(undefined)).toBe("");
+  });
+
+  it("round-trips an argument that contains commas", () => {
+    const args = ["--allowedTools", "Read,Glob,Grep,Bash(curl *http://127.0.0.1:41402/*)"];
+    const text = formatArgList(args);
+
+    expect(text).toBe('--allowedTools, "Read,Glob,Grep,Bash(curl *http://127.0.0.1:41402/*)"');
+    expect(parseCommaArgs(text)).toEqual(args);
+  });
+
+  it("round-trips quotes, backslashes and surrounding whitespace", () => {
+    const args = ['"quoted"', "a\\b,c", " padded ", 'say "hi", twice'];
+
+    expect(parseCommaArgs(formatArgList(args))).toEqual(args);
+  });
+
+  it("leaves a quote inside an unquoted argument alone", () => {
+    expect(parseCommaArgs('--name="a b", --x')).toEqual(['--name="a b"', "--x"]);
+  });
+
+  it("falls back to plain splitting when a quoted argument is malformed", () => {
+    expect(parseCommaArgs('"unterminated, --x')).toEqual(['"unterminated', "--x"]);
+    expect(parseCommaArgs('"a" trailing, --x')).toEqual(['"a" trailing', "--x"]);
+    expect(parseCommaArgs('"bad \\q escape", --x')).toEqual(['"bad \\q escape"', "--x"]);
+  });
+});
