@@ -0,0 +1,50 @@
+/**
+ * Comma-separated argument lists as shown in agent config fields.
+ * An argument that itself contains a comma is written as a JSON string
+ * ("Read,Glob") so it survives a format/parse round trip.
+ */
+export function formatArgList(value: unknown): string {
+  if (Array.isArray(value)) {
+    return value
+      .filter((item): item is string => typeof item === "string")
+      .map((item) => (item.includes(",") || item.startsWith('"') || item !== item.trim() ? JSON.stringify(item) : item))
+      .join(", ");
+  }
+  return typeof value === "string" ? value : "";
+}
+
+function readQuotedArg(value: string, start: number): { arg: string; end: number } | null {
+  let end = start + 1;
+  while (end < value.length && value[end] !== '"') end += value[end] === "\\" ? 2 : 1;
+  if (end >= value.length) return null;
+  const rest = value.slice(end + 1);
+  const next = rest.search(/\S/);
+  if (next !== -1 && rest[next] !== ",") return null;
+  try {
+    const arg: unknown = JSON.parse(value.slice(start, end + 1));
+    return typeof arg === "string" ? { arg, end: end + 1 } : null;
+  } catch {
+    return null;
+  }
+}
+
+export function parseCommaArgs(value: string): string[] {
+  const args: string[] = [];
+  let index = 0;
+  while (index < value.length) {
+    while (index < value.length && /\s/.test(value[index]!)) index += 1;
+    const quoted = value[index] === '"' ? readQuotedArg(value, index) : null;
+    if (quoted) {
+      if (quoted.arg) args.push(quoted.arg);
+      index = quoted.end;
+    }
+    const comma = value.indexOf(",", index);
+    const end = comma === -1 ? value.length : comma;
+    if (!quoted) {
+      const arg = value.slice(index, end).trim();
+      if (arg) args.push(arg);
+    }
+    index = end + 1;
+  }
+  return args;
+}
