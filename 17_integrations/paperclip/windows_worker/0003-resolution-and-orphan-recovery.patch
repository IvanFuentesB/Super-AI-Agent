diff --git a/packages/adapter-utils/src/windows-worker-startup.test.ts b/packages/adapter-utils/src/windows-worker-startup.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8193d593a870f8e16acd1b66fd95aa9e233d99a7
--- /dev/null
+++ b/packages/adapter-utils/src/windows-worker-startup.test.ts
@@ -0,0 +1,69 @@
+import { ChildProcess } from "node:child_process";
+import { readFileSync } from "node:fs";
+import vm from "node:vm";
+import ts from "typescript";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+// Run the real boundary function with only the resolver/native spawn seams mocked.
+const text = readFileSync(new URL("./server-utils.ts", import.meta.url), "utf8");
+const ast = ts.createSourceFile("server-utils.ts", text, ts.ScriptTarget.Latest, true);
+const node = ast.statements.find((statement): statement is ts.FunctionDeclaration =>
+  ts.isFunctionDeclaration(statement) && statement.name?.text === "runChildProcess")!;
+const code = ts.transpileModule(node.getText(ast).replace("export ", ""), {
+  compilerOptions: { target: ts.ScriptTarget.ES2022 },
+}).outputText;
+
+function fixture() {
+  let release!: (value: unknown) => void;
+  const resolver = new Promise((resolve) => { release = resolve; });
+  const registry = new Map();
+  const native = vi.fn(() => { throw new Error("late native launch"); });
+  const fence = vi.fn();
+  const run = vm.runInNewContext(`${code};runChildProcess`, {
+    ChildProcess, process: { platform: "win32", env: {} }, console,
+    performance: { now: () => Date.now() }, setTimeout, clearTimeout,
+    runningProcesses: registry, sanitizeInheritedPaperclipEnv: () => ({}),
+    ensurePathInEnv: (env: unknown) => env, resolveSpawnTarget: () => resolver,
+    runWindowsWorker: native, cancelWindowsRunBeforeSpawn: fence,
+  });
+  return { run, registry, native, fence, release };
+}
+const opts = (timeoutSec: number) => ({ cwd: ".", env: {}, timeoutSec, graceSec: 1, onLog: async () => {} });
+afterEach(() => vi.useRealTimers());
+
+describe("Windows resolution settlement", () => {
+  it("settles a stalled resolver at the original deadline and disposes a late target", async () => {
+    vi.useFakeTimers();
+    const f = fixture();
+    const result = f.run("deadline", "worker", [], opts(1));
+    await vi.advanceTimersByTimeAsync(1001);
+    expect(await result).toMatchObject({ timedOut: true, cleanupVerified: true, pid: null, executionStatus: "failed" });
+    const cleanup = vi.fn(async () => {});
+    f.release({ command: "worker", args: [], cleanup });
+    await vi.runAllTimersAsync();
+    expect(cleanup).toHaveBeenCalledOnce();
+    expect(f.native).not.toHaveBeenCalled();
+    expect(f.fence).toHaveBeenCalledWith("deadline");
+    expect(f.registry.size).toBe(0);
+  });
+  it("settles cancellation without waiting for resolution and fences late launch", async () => {
+    const f = fixture();
+    const result = f.run("cancel", "worker", [], opts(5));
+    await f.registry.get("cancel").stop();
+    expect(await result).toMatchObject({ executionStatus: "cancelled", cleanupVerified: true, pid: null });
+    const cleanup = vi.fn(async () => {});
+    f.release({ command: "worker", args: [], cleanup });
+    await new Promise((resolve) => setImmediate(resolve));
+    expect(cleanup).toHaveBeenCalledOnce();
+    expect(f.native).not.toHaveBeenCalled();
+  });
+  it("bounds resolution startup even when execution timeout is disabled", async () => {
+    vi.useFakeTimers();
+    const f = fixture();
+    const result = f.run("unlimited", "worker", [], opts(0));
+    await vi.advanceTimersByTimeAsync(30001);
+    expect(await result).toMatchObject({ executionStatus: "failed", cleanupVerified: true, pid: null });
+    expect(f.native).not.toHaveBeenCalled();
+    expect(f.registry.size).toBe(0);
+  });
+});
