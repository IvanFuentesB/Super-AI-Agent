@@ -0,0 +1,146 @@
+import { spawn, type ChildProcess } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { fileURLToPath } from "node:url";
+import path from "node:path";
+import { StringDecoder } from "node:string_decoder";
+import type { RunProcessResult, TerminalResultCleanupOptions } from "./server-utils.js";
+
+export interface WindowsOwner {
+  child: ChildProcess;
+  graceSec: number;
+  processGroupId: null;
+  stop: () => Promise<void>;
+}
+
+// A run ID is immutable in Paperclip. Reject overlap even while spawn metadata is pending.
+const attempts = new Map<string, { deadline: number | null; stopped: boolean }>();
+export function runWindowsWorker(
+  runId: string, command: string, args: string[],
+  opts: {
+    cwd: string; env: NodeJS.ProcessEnv; timeoutSec: number; graceSec: number; stdin?: string;
+    onLog: (stream: "stdout" | "stderr", chunk: string) => Promise<void>;
+    onSpawn?: (meta: { pid: number; processGroupId: null; startedAt: string }) => Promise<void>;
+    terminalResultCleanup?: TerminalResultCleanupOptions;
+  },
+  registry: Map<string, { child: ChildProcess; graceSec: number; processGroupId: number | null; stop?: () => Promise<void> }>,
+): Promise<RunProcessResult> {
+  const python = process.env.PAPERCLIP_WINDOWS_PYTHON;
+  if (!python || !path.isAbsolute(python)) {
+    return Promise.reject(new Error("Windows worker requires an explicitly configured absolute PAPERCLIP_WINDOWS_PYTHON path"));
+  }
+  const previous = attempts.get(runId);
+  if (registry.has(runId) || previous?.stopped) return Promise.reject(new Error("Worker run ID already active or stopped"));
+  const identity = randomUUID();
+  const startedAt = new Date().toISOString();
+  const budget = previous ?? { deadline: opts.timeoutSec > 0 ? Date.now() / 1000 + opts.timeoutSec : null, stopped: false };
+  attempts.set(runId, budget);
+  const deadline = budget.deadline;
+  const child = spawn(python, ["-I", "-B", fileURLToPath(new URL("../src/windows-worker.py", import.meta.url))], {
+    cwd: opts.cwd, env: opts.env, shell: false, windowsHide: true, stdio: ["pipe", "pipe", "pipe"],
+  });
+  let cancelRequested = false;
+  let completed: RunProcessResult | undefined;
+  let failure: Error | undefined;
+  let pid: number | null = null;
+  let stdout = "";
+  let stderr = "";
+  let pending = "";
+  let logs = Promise.resolve();
+  let terminalTimer: NodeJS.Timeout | undefined;
+  let terminalSeen = false;
+  const decoders = { stdout: new StringDecoder("utf8"), stderr: new StringDecoder("utf8") };
+  const send = (type: string) => {
+    if (!child.stdin.destroyed) child.stdin.write(JSON.stringify({ identity, type }) + "\n");
+  };
+  let finish!: () => void;
+  const exited = new Promise<void>((resolve) => { finish = resolve; });
+  const owner: WindowsOwner = {
+    child, graceSec: opts.graceSec, processGroupId: null,
+    stop: async () => {
+      cancelRequested = true;
+      budget.stopped = true;
+      send("cancel");
+      await exited;
+      if (failure || !completed?.cleanupVerified) throw failure ?? new Error("Windows worker cleanup uncertain");
+    },
+  };
+  registry.set(runId, owner);
+  // The helper independently owns the deadline and notices owner EOF, even if JS is stuck.
+  child.stdin.on("error", () => {});
+  child.stdin.write(JSON.stringify({ identity, command, args, cwd: opts.cwd, stdin: opts.stdin, deadline }) + "\n");
+  const watchdog = setTimeout(() => {
+    failure = new Error("Windows worker cleanup uncertain: owner receipt deadline exceeded");
+    child.kill(); // Sole helper handle; its noninherited job handle closes with it.
+  }, (deadline ? Math.max(0, deadline * 1000 - Date.now()) : 0x7fffffff - 10000) + 8000);
+  const controlWatchdog = () => {
+    const timer = setTimeout(() => {
+      if (!completed) {
+        failure = new Error("Windows worker cleanup uncertain: cancellation receipt missing");
+        child.kill();
+      }
+    }, 8000);
+    timer.unref();
+  };
+  const originalStop = owner.stop;
+  owner.stop = () => { controlWatchdog(); return originalStop(); };
+  child.stdout.on("data", (chunk: Buffer) => {
+    pending += chunk.toString("utf8");
+    if (pending.length > 128 * 1024) { failure = new Error("Invalid Windows worker frame"); void owner.stop().catch(() => {}); return; }
+    let at: number;
+    while ((at = pending.indexOf("\n")) >= 0) {
+      const line = pending.slice(0, at); pending = pending.slice(at + 1);
+      try {
+        const event = JSON.parse(line);
+        if (event.identity !== identity || completed) throw new Error("Invalid Windows worker identity/order");
+        if (event.type === "spawn") {
+          if (pid !== null || !Number.isInteger(event.pid) || event.pid <= 0) throw new Error("Invalid worker PID");
+          pid = event.pid;
+          void Promise.resolve().then(() => opts.onSpawn?.({ pid: event.pid, processGroupId: null, startedAt }))
+            .then(() => send(cancelRequested ? "cancel" : "resume"))
+            .catch(() => { failure = new Error("Worker spawn metadata failed"); void owner.stop().catch(() => {}); });
+        } else if (event.type === "output" && (event.stream === "stdout" || event.stream === "stderr")) {
+          const stream = event.stream as "stdout" | "stderr";
+          const text = decoders[stream].write(Buffer.from(event.data, "base64"));
+          if (stream === "stdout") stdout = (stdout + text).slice(-4 * 1024 * 1024);
+          else stderr = (stderr + text).slice(-4 * 1024 * 1024);
+          logs = logs.then(() => opts.onLog(stream, text)).catch(() => {});
+          if (!terminalSeen && opts.terminalResultCleanup?.hasTerminalResult({ stdout, stderr })) {
+            terminalSeen = true;
+            terminalTimer = setTimeout(() => { void owner.stop().catch(() => {}); }, opts.terminalResultCleanup.graceMs ?? 5000);
+          }
+        } else if (event.type === "result") {
+          if (event.cleanupVerified !== true || !["completed", "failed", "cancelled", "timed_out"].includes(event.status)) {
+            const nativeCode = Number.isInteger(event.nativeErrorCode) ? ` (Win32 ${event.nativeErrorCode})` : "";
+            throw new Error(`Windows worker cleanup uncertain${nativeCode}`);
+          }
+          completed = {
+            exitCode: event.exitCode, signal: event.status === "cancelled" ? "SIGTERM" : null,
+            timedOut: event.status === "timed_out", stdout, stderr, pid, startedAt,
+            cleanupVerified: true, ownershipId: identity, ownedPids: event.ownedPids,
+            executionStatus: event.status === "timed_out" ? "failed" : event.status,
+          };
+          if (event.status === "timed_out" || event.status === "cancelled") budget.stopped = true;
+        } else throw new Error("Invalid Windows worker event");
+      } catch (err) {
+        failure = err instanceof Error ? err : new Error("Invalid Windows worker protocol");
+        void owner.stop().catch(() => {});
+      }
+    }
+  });
+  child.stderr.resume(); // Helper diagnostics never contain worker output or credentials.
+  child.on("error", () => { failure = new Error("Windows worker helper failed to start"); });
+  child.on("close", (code) => {
+    if (code !== 0) failure = new Error("Windows worker execution uncertain: helper exited abnormally");
+    clearTimeout(watchdog);
+    if (terminalTimer) clearTimeout(terminalTimer);
+    if (registry.get(runId) === owner) registry.delete(runId);
+    if (failure || !completed) budget.stopped = true;
+    finish();
+  });
+  return exited.then(async () => {
+    // Logging cannot delay OS cleanup/cancellation confirmation indefinitely.
+    await Promise.race([logs, new Promise((resolve) => { const t = setTimeout(resolve, 1000); t.unref(); })]);
+    if (failure || !completed) throw failure ?? new Error("Windows worker execution uncertain: missing cleanup receipt");
+    return completed;
+  });
+}
