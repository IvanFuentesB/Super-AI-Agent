index 0000000000000000000000000000000000000000..a02ae68198f363a25c27c83f20c8df76b00466c0
--- /dev/null
+++ b/packages/adapter-utils/src/windows-worker.test.ts
@@ -0,0 +1,182 @@
+import { spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { mkdir, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { afterAll, describe, expect, it } from "vitest";
+import { runChildProcess, runningProcesses, type RunProcessResult } from "./server-utils.js";
+
+const evidence: unknown[] = [];
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+const alive = (pid: number) => { try { process.kill(pid, 0); return true; } catch { return false; } };
+async function until(check: () => boolean, ms = 5000) {
+  const end = Date.now() + ms;
+  while (!check() && Date.now() < end) await sleep(20);
+  expect(check()).toBe(true);
+}
+const opts = () => ({ cwd: os.tmpdir(), env: {}, timeoutSec: 5, graceSec: 1, onLog: async () => {} });
+const tree = (rootExit = false) => {
+  const leaf = "console.log('leaf:'+process.pid);setInterval(()=>{},1000)";
+  const branch = `const{spawn}=require('node:child_process');spawn(process.execPath,['-e',${JSON.stringify(leaf)}],{detached:true,stdio:['ignore','inherit','inherit']});console.log('branch:'+process.pid);setInterval(()=>{},1000)`;
+  return `const{spawn}=require('node:child_process');spawn(process.execPath,['-e',${JSON.stringify(branch)}],{detached:true,stdio:['ignore','inherit','inherit']});console.log('root:'+process.pid);${rootExit ? "setTimeout(()=>process.exit(0),400)" : "setInterval(()=>{},1000)"}`;
+};
+function assertEmpty(result: RunProcessResult) {
+  expect(result.cleanupVerified).toBe(true);
+  expect(result.ownershipId).toMatch(/^[a-f0-9-]{36}$/);
+  const outputPids = [...result.stdout.matchAll(/(?:root|branch|leaf):(\d+)/g)].map((m) => Number(m[1]));
+  for (const pid of [...(result.ownedPids ?? []), ...outputPids]) expect(alive(pid)).toBe(false);
+  evidence.push({ ...result, node: process.version, outputPids, allObservedExited: true });
+}
+
+describe.skipIf(process.platform !== "win32")("Windows owned worker boundary", () => {
+  it("completes an actual bounded worker with exact UTF-8 stdin/stdout", async () => {
+    const result = await runChildProcess(randomUUID(), process.execPath,
+      ["-e", "process.stdin.pipe(process.stdout)"], { ...opts(), stdin: "supervised fixture 日本語 😀" });
+    expect(result.stdout).toBe("supervised fixture 日本語 😀");
+    expect(result.executionStatus).toBe("completed");
+    assertEmpty(result);
+  });
