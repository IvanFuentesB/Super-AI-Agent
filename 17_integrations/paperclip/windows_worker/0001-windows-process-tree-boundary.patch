@@ -0,0 +1,36 @@
+import { EventEmitter } from "node:events";
+import { PassThrough } from "node:stream";
+import { describe, expect, it, vi } from "vitest";
+
+let current: any;
+vi.mock("node:child_process", () => ({ spawn: () => current }));
+import { runWindowsWorker } from "./windows-worker.js";
+
+describe("Windows cleanup receipts", () => {
+  it.each(["missing", "unverified", "wrong_identity", "abnormal_exit"])("refuses %s cleanup evidence", async (mode) => {
+    current = Object.assign(new EventEmitter(), {
+      stdin: new PassThrough(), stdout: new PassThrough(), stderr: new PassThrough(),
+      kill() { queueMicrotask(() => current.emit("close", 125)); },
+    });
+    const saved = process.env.PAPERCLIP_WINDOWS_PYTHON;
+    process.env.PAPERCLIP_WINDOWS_PYTHON = process.execPath;
+    try {
+      let input = "";
+      current.stdin.on("data", (chunk: Buffer) => { input += chunk.toString(); });
+      const promise = runWindowsWorker(crypto.randomUUID(), process.execPath, [], {
+        cwd: process.cwd(), env: {}, timeoutSec: 1, graceSec: 1, onLog: async () => {},
+      }, new Map());
+      const rejected = expect(promise).rejects.toThrow(/uncertain|identity/);
+      const packet = JSON.parse(input.trim());
+      if (mode !== "missing") current.stdout.write(JSON.stringify({
+        type: "result", identity: mode === "wrong_identity" ? "old-attempt" : packet.identity,
+        cleanupVerified: mode !== "unverified", status: "completed", exitCode: 0, ownedPids: [],
+      }) + "\n");
+      current.emit("close", mode === "abnormal_exit" ? 1 : 0);
+      await rejected;
+    } finally {
+      if (saved === undefined) delete process.env.PAPERCLIP_WINDOWS_PYTHON;
+      else process.env.PAPERCLIP_WINDOWS_PYTHON = saved;
+    }
+  });
+});
diff --git a/packages/adapter-utils/src/windows-worker.py b/packages/adapter-utils/src/windows-worker.py
