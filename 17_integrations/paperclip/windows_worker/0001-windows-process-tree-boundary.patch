index 0000000000000000000000000000000000000000..35f04e84a398c8aed0622ea91230db8b6c5d8a04
--- /dev/null
+++ b/packages/adapter-utils/src/windows-worker.py
@@ -0,0 +1,250 @@
+"""Private Windows Job bridge for adapter-utils. JSON stdio is control, never worker stdio."""
+import base64
+import ctypes as c
+from ctypes import wintypes as w
+import json
+import msvcrt
+import os
+import queue
+import subprocess
+import sys
+import threading
+import time
+
+
+class Basic(c.Structure):
+    _fields_ = [("process_time", c.c_int64), ("job_time", c.c_int64),
+                ("flags", w.DWORD), ("min_working", c.c_size_t),
+                ("max_working", c.c_size_t), ("active", w.DWORD),
+                ("affinity", c.c_size_t), ("priority", w.DWORD), ("scheduling", w.DWORD)]
+
+
+class Limits(c.Structure):
+    _fields_ = [("basic", Basic), ("io", c.c_uint64 * 6),
+                ("process_memory", c.c_size_t), ("job_memory", c.c_size_t),
+                ("peak_process", c.c_size_t), ("peak_job", c.c_size_t)]
+
+
+class Startup(c.Structure):
+    _fields_ = [("cb", w.DWORD), ("reserved", w.LPWSTR), ("desktop", w.LPWSTR),
+                ("title", w.LPWSTR), ("x", w.DWORD), ("y", w.DWORD),
+                ("xs", w.DWORD), ("ys", w.DWORD), ("xc", w.DWORD), ("yc", w.DWORD),
+                ("fill", w.DWORD), ("flags", w.DWORD), ("show", w.WORD),
+                ("reserved_size", w.WORD), ("reserved_bytes", c.c_void_p),
+                ("stdin", w.HANDLE), ("stdout", w.HANDLE), ("stderr", w.HANDLE)]
+
+
+class StartupEx(c.Structure):
+    _fields_ = [("startup", Startup), ("attributes", c.c_void_p)]
+
+
+class ProcessInfo(c.Structure):
+    _fields_ = [("process", w.HANDLE), ("thread", w.HANDLE), ("pid", w.DWORD), ("tid", w.DWORD)]
+
+
+kernel = c.WinDLL("kernel32", use_last_error=True)
+for name, args, result in [
+    ("CreateJobObjectW", [c.c_void_p, w.LPCWSTR], w.HANDLE),
+    ("SetInformationJobObject", [w.HANDLE, c.c_int, c.c_void_p, w.DWORD], w.BOOL),
+    ("QueryInformationJobObject", [w.HANDLE, c.c_int, c.c_void_p, w.DWORD, c.c_void_p], w.BOOL),
+    ("TerminateJobObject", [w.HANDLE, w.UINT], w.BOOL),
+    ("CloseHandle", [w.HANDLE], w.BOOL),
+    ("InitializeProcThreadAttributeList", [c.c_void_p, w.DWORD, w.DWORD, c.POINTER(c.c_size_t)], w.BOOL),
+    ("UpdateProcThreadAttribute", [c.c_void_p, w.DWORD, c.c_size_t, c.c_void_p, c.c_size_t, c.c_void_p, c.c_void_p], w.BOOL),
+    ("DeleteProcThreadAttributeList", [c.c_void_p], None),
+    ("CreateProcessW", [w.LPCWSTR, w.LPWSTR, c.c_void_p, c.c_void_p, w.BOOL, w.DWORD,
+                        c.c_void_p, w.LPCWSTR, c.c_void_p, c.POINTER(ProcessInfo)], w.BOOL),
+    ("ResumeThread", [w.HANDLE], w.DWORD),
+    ("WaitForSingleObject", [w.HANDLE, w.DWORD], w.DWORD),
+    ("GetExitCodeProcess", [w.HANDLE, c.POINTER(w.DWORD)], w.BOOL),
+    ("GetProcessTimes", [w.HANDLE, c.c_void_p, c.c_void_p, c.c_void_p, c.c_void_p], w.BOOL),
+]:
+    fn = getattr(kernel, name)
+    fn.argtypes, fn.restype = args, result
+
+
+def checked(value):
+    if not value:
+        raise c.WinError(c.get_last_error())
+    return value
+
+
+def main():
+    packet = json.loads(sys.stdin.buffer.readline(8 * 1024 * 1024))
+    identity = packet["identity"]
+    events = queue.Queue(maxsize=128)
+    stopped = threading.Event()
+    reason = ["cancelled"]
+    written = threading.Event()
+    resume = threading.Event()
+
+    def emit(value):
+        value["identity"] = identity
+        try:
+            events.put_nowait(value)
+        except queue.Full:
+            reason[0] = "uncertain"
+            stopped.set()
+
+    def writer():
+        while True:
+            value = events.get()
+            data = (json.dumps(value) + "\n").encode()
+            try:
+                while data:
+                    data = data[os.write(sys.stdout.fileno(), data):]
+            except OSError:
+                stopped.set()
+                return
+            if value["type"] == "result":
+                written.set()
+                return
+
+    def control():
+        # EOF means the Node owner disappeared. No persisted PID can reopen this channel.
+        for line in sys.stdin.buffer:
+            try:
+                value = json.loads(line)
+                if value == {"identity": identity, "type": "cancel"}:
+                    stopped.set()
+                elif value == {"identity": identity, "type": "resume"}:
+                    resume.set()
+            except (ValueError, TypeError):
+                stopped.set()
+        stopped.set()
+
+    threading.Thread(target=writer, daemon=True).start()
+    threading.Thread(target=control, daemon=True).start()
+    job = checked(kernel.CreateJobObjectW(None, None))
+    pi = ProcessInfo()
+    attrs = None
+    fds = []
+    readers = []
+    owned = set()
+    status = "uncertain"
+    code = None
+    verified = False
+    native_error = None
+    try:
+        limits = Limits()
+        limits.basic.flags = 0x2000  # KILL_ON_JOB_CLOSE; never permit breakaway.
+        checked(kernel.SetInformationJobObject(job, 9, c.byref(limits), c.sizeof(limits)))
+        size = c.c_size_t()
+        kernel.InitializeProcThreadAttributeList(None, 2, 0, c.byref(size))
+        attrs = c.create_string_buffer(size.value)
+        checked(kernel.InitializeProcThreadAttributeList(attrs, 2, 0, c.byref(size)))
+        job_list = (w.HANDLE * 1)(job)
+        checked(kernel.UpdateProcThreadAttribute(attrs, 0, 0x2000D, job_list, c.sizeof(job_list), None, None))
+        in_r, in_w = os.pipe()
+        out_r, out_w = os.pipe()
+        err_r, err_w = os.pipe()
+        fds = [in_r, in_w, out_r, out_w, err_r, err_w]
+        inherited = (w.HANDLE * 3)(*[msvcrt.get_osfhandle(fd) for fd in (in_r, out_w, err_w)])
+        for fd in (in_r, out_w, err_w):
+            os.set_inheritable(fd, True)
+        checked(kernel.UpdateProcThreadAttribute(attrs, 0, 0x20002, inherited, c.sizeof(inherited), None, None))
+        si = StartupEx()
+        si.startup.cb = c.sizeof(si)
+        si.startup.flags = 0x100  # STARTF_USESTDHANDLES
+        si.startup.stdin, si.startup.stdout, si.startup.stderr = inherited
+        si.attributes = c.cast(attrs, c.c_void_p)
+        command = c.create_unicode_buffer(subprocess.list2cmdline([packet["command"], *packet["args"]]))
+        deadline = packet.get("deadline")
+        if stopped.is_set() or (deadline and time.time() >= deadline):
+            status = "cancelled" if stopped.is_set() else "timed_out"
+        else:
+            # Atomic job membership closes even the suspended-child startup crash gap.
+            checked(kernel.CreateProcessW(packet["command"], command, None, None, True,
+                                          0x80000 | 0x4 | 0x8000000, None, packet["cwd"], c.byref(si), c.byref(pi)))
+            owned.add(pi.pid)
+            times = [c.c_uint64() for _ in range(4)]
+            checked(kernel.GetProcessTimes(pi.process, *[c.byref(t) for t in times]))
+            emit({"type": "spawn", "pid": pi.pid, "creationTime": str(times[0].value)})
+            for fd in (in_r, out_w, err_w):
+                os.close(fd)
+                fds.remove(fd)
+
+            def relay(fd, stream):
+                try:
+                    while chunk := os.read(fd, 4096):
+                        emit({"type": "output", "stream": stream, "data": base64.b64encode(chunk).decode()})
+                except OSError:
+                    pass
+
+            for fd, stream in ((out_r, "stdout"), (err_r, "stderr")):
+                thread = threading.Thread(target=relay, args=(fd, stream), daemon=True)
+                thread.start()
+                readers.append(thread)
+
+            def feed():
+                try:
+                    data = packet.get("stdin", "").encode("utf-8")
+                    while data:
+                        data = data[os.write(in_w, data):]
+                except OSError:
+                    pass
+                finally:
+                    os.close(in_w)
+
+            fds.remove(in_w)
+            threading.Thread(target=feed, daemon=True).start()
+            while not resume.is_set() and not stopped.is_set() and not (deadline and time.time() >= deadline):
+                time.sleep(0.02)
+            if not stopped.is_set() and not (deadline and time.time() >= deadline):
+                if kernel.ResumeThread(pi.thread) == 0xFFFFFFFF:
+                    raise c.WinError(c.get_last_error())
+            while True:
+                pids = c.create_string_buffer(8 + 8 * 4096)
+                checked(kernel.QueryInformationJobObject(job, 3, pids, len(pids), None))
+                count = w.DWORD.from_buffer(pids, 4).value
+                owned.update(c.c_size_t.from_buffer(pids, 8 + i * c.sizeof(c.c_size_t)).value for i in range(count))
+                if stopped.is_set():
+                    status = reason[0]
+                    break
+                if deadline and time.time() >= deadline:
+                    status = "timed_out"
+                    break
+                if kernel.WaitForSingleObject(pi.process, 0) == 0:
+                    exit_code = w.DWORD()
+                    checked(kernel.GetExitCodeProcess(pi.process, c.byref(exit_code)))
+                    code = exit_code.value
+                    status = "completed" if code == 0 else "failed"
+                    break
+                time.sleep(0.02)
+    except Exception as error:
+        # Do not echo argv, env, prompt or native exception content into logs.
+        status = "uncertain"
+        native_error = getattr(error, "winerror", None)
+    finally:
+        try:
+            checked(kernel.TerminateJobObject(job, 1))
+            until = time.monotonic() + 5
+            while time.monotonic() < until:
+                accounting = c.create_string_buffer(48)
+                checked(kernel.QueryInformationJobObject(job, 1, accounting, 48, None))
+                if w.DWORD.from_buffer(accounting, 40).value == 0:
+                    verified = True
+                    break
+                time.sleep(0.02)
+        except Exception:
+            verified = False
+        for thread in readers:
+            thread.join(timeout=0.5)
+        for fd in fds:
+            os.close(fd)
+        if pi.thread:
+            kernel.CloseHandle(pi.thread)
+        if pi.process:
+            kernel.CloseHandle(pi.process)
+        if attrs:
+            kernel.DeleteProcThreadAttributeList(attrs)
+        kernel.CloseHandle(job)
+    emit({"type": "result", "status": status if verified else "uncertain",
+          "cleanupVerified": verified, "exitCode": code, "ownedPids": sorted(owned),
+          "nativeErrorCode": native_error})
+    written.wait(timeout=2)
+    os._exit(0 if written.is_set() and verified else 125)
+
+
+if __name__ == "__main__":
+    main()
