diff --git a/packages/adapter-utils/src/windows-worker-heartbeat.test.ts b/packages/adapter-utils/src/windows-worker-heartbeat.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..185945ee1c0e4978bae86cd7b55c2ff11b7f04b8
--- /dev/null
+++ b/packages/adapter-utils/src/windows-worker-heartbeat.test.ts
@@ -0,0 +1,61 @@
+// Exercise the actual heartbeat function bodies in memory, without loading DB/services.
+import { readFileSync } from "node:fs";
+import vm from "node:vm";
+import ts from "typescript";
+import { describe, expect, it, vi } from "vitest";
+
+const source = readFileSync(new URL("../../../server/src/services/heartbeat.ts", import.meta.url), "utf8");
+const ast = ts.createSourceFile("heartbeat.ts", source, ts.ScriptTarget.Latest, true);
+function load(name: string, globals: Record<string, unknown>) {
+  let match: ts.FunctionDeclaration | undefined;
+  function visit(node: ts.Node) {
+    if (ts.isFunctionDeclaration(node) && node.name?.text === name) match = node;
+    ts.forEachChild(node, visit);
+  }
+  visit(ast);
+  if (!match) throw new Error(`Missing actual heartbeat function ${name}`);
+  const code = ts.transpileModule(match.getText(ast), { compilerOptions: { target: ts.ScriptTarget.ES2022 } }).outputText;
+  return vm.runInNewContext(`${code};${name}`, globals);
+}
+
+describe("Windows heartbeat ownership policy", () => {
+  it("refuses an unknown persisted PID and does not call legacy termination", async () => {
+    const terminate = vi.fn();
+    const stop = load("terminateHeartbeatRunProcess", { process: { platform: "win32" }, runningProcesses: new Map(),
+      cancelWindowsRunBetweenAttempts: () => false, terminateLocalService: terminate });
+    await expect(stop({ runId: "old", pid: 1234, processGroupId: null })).rejects.toThrow(/uncertain/);
+    expect(terminate).not.toHaveBeenCalled();
+  });
+  it("waits for the live owner to verify cleanup before resolving stop", async () => {
+    let release!: () => void;
+    const gate = new Promise<void>((resolve) => { release = resolve; });
+    const stop = load("terminateHeartbeatRunProcess", { process: { platform: "win32" },
+      runningProcesses: new Map([["owned", { stop: () => gate }]]) });
+    let finished = false;
+    const pending = stop({ runId: "owned", pid: 1234 }).then(() => { finished = true; });
+    await Promise.resolve();
+    expect(finished).toBe(false);
+    release(); await pending;
+    expect(finished).toBe(true);
+  });
+  it("keeps an uncertain run's issue execution lock and suppresses promotion", async () => {
+    const getAgent = vi.fn(() => { throw new Error("must not release/promote"); });
+    const release = load("releaseIssueExecutionAndPromote", { isWindowsWorkerCleanupUncertain: () => false, getAgent });
+    await release({ id: "uncertain", errorCode: "worker_cleanup_uncertain" });
+    expect(getAgent).not.toHaveBeenCalled();
+  });
+  it("does not start queued replacement work while cleanup is unverified", async () => {
+    const getAgent = vi.fn(() => { throw new Error("must not start work"); });
+    const start = load("startNextQueuedRunForAgent", { withAgentStartLock: (_id: string, fn: () => unknown) => fn(),
+      hasUnverifiedWorkerCleanup: async () => true, getAgent });
+    expect(await start("agent")).toEqual([]);
+    expect(getAgent).not.toHaveBeenCalled();
+  });
+  it("keeps direct execution behind the same cleanup gate", async () => {
+    const claim = vi.fn();
+    const execute = load("executeRun", { getRun: async () => ({ id: "new", status: "queued", agentId: "agent" }),
+      hasUnverifiedWorkerCleanup: async () => true, claimQueuedRun: claim });
+    await execute("new");
+    expect(claim).not.toHaveBeenCalled();
+  });
+});
