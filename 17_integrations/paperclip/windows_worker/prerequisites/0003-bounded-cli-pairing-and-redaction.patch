+// Inert fixtures only: no live challenge, browser, account or approval.
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+vi.mock("node:child_process", () => ({ spawn: vi.fn(() => ({ unref() {} })) }));
+import { loginBoardCli, getStoredBoardCredential } from "../client/board-auth.js";
+
+const base = "http://fixture.invalid";
+const challengeId = "11111111-1111-4111-8111-111111111111";
+let dir: string;
+let events: any[];
+let pollCount: number;
+let status: "pending" | "approved" | "cancelled" | "expired";
+let interrupt: boolean;
+let expiry: string;
+let controller: AbortController;
+let request: ReturnType<typeof vi.fn>;
+const json = (data: unknown, code = 200) => new Response(JSON.stringify(data), { status: code });
+function login() {
+  return loginBoardCli({ apiBase: base, requestedAccess: "board", print: false,
+    storePath: path.join(dir, "auth.json"), signal: controller.signal,
+    onEvent: (e: any) => events.push(e), openBrowser: () => true });
+}
+beforeEach(() => {
+  vi.useFakeTimers(); vi.setSystemTime(new Date("2026-01-01T00:00:00Z"));
+  dir = fs.mkdtempSync(path.join(os.tmpdir(), "paperclip-fixture-lifecycle-"));
+  events = []; pollCount = 0; status = "pending"; interrupt = false;
+  expiry = new Date(Date.now() + 600_000).toISOString(); controller = new AbortController();
+  request = vi.fn(async (input: string, init: RequestInit) => {
+    if (input === base + "/api/cli-auth/challenges") return json({ id: challengeId,
+      token: "FIXTURE_PAIRING_SECRET", boardApiToken: "FIXTURE_BOARD_SECRET",
+      approvalUrl: base + "/cli-auth/" + challengeId + "?token=FIXTURE_PAIRING_SECRET",
+      pollPath: "/cli-auth/challenges/" + challengeId, expiresAt: expiry, suggestedPollIntervalMs: 1000 });
+    if (input.includes("?token=")) {
+      pollCount++;
+      if (interrupt) { interrupt = false; throw new TypeError("FIXTURE_PAIRING_SECRET fetch failure"); }
+      return json({ id: challengeId, status });
+    }
+    if (input === base + "/api/cli-auth/me") return json({ userId: "FIXTURE_PRIVATE_ID" });
+    throw new Error("unexpected fixture route");
+  });
+  vi.stubGlobal("fetch", request);
+});
+afterEach(() => { vi.useRealTimers(); vi.unstubAllGlobals(); fs.rmSync(dir, { recursive: true, force: true }); });
+
+describe("bounded native CLI authentication", () => {
+  it("waits through delayed human response, consumes one challenge, verifies identity then stores", async () => {
+    let settled = false;
+    const result = login().finally(() => { settled = true; });
+    await vi.advanceTimersByTimeAsync(180_000);
+    expect(settled).toBe(false); expect(pollCount).toBeGreaterThan(150);
+    status = "approved"; await vi.advanceTimersByTimeAsync(1000); await result;
+    expect(request.mock.calls.filter(([u]) => u === base + "/api/cli-auth/challenges")).toHaveLength(1);
+    expect(getStoredBoardCredential(base, path.join(dir, "auth.json"))?.token).toBe("FIXTURE_BOARD_SECRET");
+    const stages = events.map(e => e.stage);
+    expect(stages.indexOf("identity_verified")).toBeLessThan(stages.indexOf("credential_stored"));
+    expect(stages).toContain("challenge_created");
+    const text = JSON.stringify(events);
+    for (const secret of ["FIXTURE_PAIRING_SECRET", "FIXTURE_BOARD_SECRET", "FIXTURE_PRIVATE_ID", "?token="]) expect(text).not.toContain(secret);
+  });
+  it("retries an interrupted status GET without replacing or extending the challenge", async () => {
+    interrupt = true;
+    const result = login(); const caught = result.catch(e => e);
+    await vi.advanceTimersByTimeAsync(3000);
+    status = "approved"; await vi.advanceTimersByTimeAsync(1000);
+    expect(await caught).not.toBeInstanceOf(Error);
+    expect(events.some(e => e.stage === "poll_interrupted")).toBe(true);
+    expect(request.mock.calls.filter(([u]) => u === base + "/api/cli-auth/challenges")).toHaveLength(1);
+  });
+  it.each(["TypeError", "TimeoutError"])("retries interrupted response body %s on the same challenge", async kind => {
+    const original = request.getMockImplementation()!;
+    let interrupted = false;
+    request.mockImplementation(async (url: string, init: RequestInit) => {
+      const response = await original(url, init);
+      if (url.includes("?token=") && !interrupted) {
+        interrupted = true;
+        vi.spyOn(response, "json").mockRejectedValueOnce(kind === "TypeError"
+          ? new TypeError("FIXTURE_PAIRING_SECRET body interrupted")
+          : new DOMException("FIXTURE_PAIRING_SECRET body timed out", "TimeoutError"));
+      }
+      return response;
+    });
+    const result = login().catch(e => e);
+    await vi.advanceTimersByTimeAsync(1000);
+    status = "approved"; await vi.advanceTimersByTimeAsync(1000);
+    expect(await result).not.toBeInstanceOf(Error);
+    expect(events.some(e => e.stage === "poll_interrupted")).toBe(true);
+    expect(request.mock.calls.filter(([u]) => u === base + "/api/cli-auth/challenges")).toHaveLength(1);
+    expect(events.find(e => e.stage === "challenge_created")?.expiresAt).toBe(expiry);
+    expect(JSON.stringify(events)).not.toContain("FIXTURE_PAIRING_SECRET");
+  });
+  it("repeated response body interruption still ends at the original expiry", async () => {
+    expiry = new Date(Date.now() + 3000).toISOString();
+    const original = request.getMockImplementation()!;
+    request.mockImplementation(async (url: string, init: RequestInit) => {
+      const response = await original(url, init);
+      if (url.includes("?token=")) vi.spyOn(response, "json").mockRejectedValue(new TypeError("fixture body interruption"));
+      return response;
+    });
+    const result = login().catch(e => e);
+    await vi.advanceTimersByTimeAsync(3001);
+    expect(await result).toBeInstanceOf(Error);
+    expect(events.at(-1)?.stage).toBe("expired");
+    expect(request.mock.calls.filter(([u]) => u === base + "/api/cli-auth/challenges")).toHaveLength(1);
+    expect(getStoredBoardCredential(base, path.join(dir, "auth.json"))).toBeNull();
+  });
+  it("malformed JSON is terminal and never includes response contents", async () => {
+    const original = request.getMockImplementation()!;
+    request.mockImplementation(async (url: string, init: RequestInit) =>
+      url.includes("?token=") ? new Response("FIXTURE_PAIRING_SECRET invalid JSON") : original(url, init));
+    const result = await login().catch(e => e);
+    expect(result).toBeInstanceOf(Error);
+    expect(result.message).not.toContain("FIXTURE");
+    expect(events.some(e => e.stage === "poll_interrupted")).toBe(false);
+    expect(request.mock.calls.filter(([u]) => u.includes("?token="))).toHaveLength(1);
+  });
+  it.each(["cancelled", "expired"] as const)("exits on %s without a credential", async terminal => {
+    status = terminal;
+    const error = await login().catch(e => e);
+    expect(error).toBeInstanceOf(Error);
+    expect(getStoredBoardCredential(base, path.join(dir, "auth.json"))).toBeNull();
+    expect(events.at(-1)?.stage).toBe(terminal);
+  });
+  it("exits at challenge expiry even if the service lease is longer", async () => {
+    expiry = new Date(Date.now() + 5000).toISOString();
+    const result = login().catch(e => e);
+    await vi.advanceTimersByTimeAsync(5001);
+    expect(await result).toBeInstanceOf(Error);
+    expect(events.at(-1)?.stage).toBe("expired");
+    expect(request.mock.calls.filter(([u]) => u === base + "/api/cli-auth/challenges")).toHaveLength(1);
+  });
+  it("aborts on owner cancellation/service stop while the challenge is still valid", async () => {
+    let settled = false;
+    const result = login().catch(e => e).finally(() => { settled = true; });
+    await vi.advanceTimersByTimeAsync(1000); controller.abort();
+    await vi.advanceTimersByTimeAsync(1000);
+    expect(settled).toBe(true);
+    if (!settled) { status = "cancelled"; await vi.advanceTimersByTimeAsync(1000); }
+    await result;
+    expect(getStoredBoardCredential(base, path.join(dir, "auth.json"))).toBeNull();
+  });
+  it("rejects malformed expiry instead of starting an unbounded poll", async () => {
+    expiry = "not-a-date"; status = "cancelled";
+    const result = await login().catch(e => e);
+    expect(result.message).toMatch(/expiry|expiration/i);
+    expect(pollCount).toBe(0);
+  });
+  it.each([200, 500])("verifies specific revocation after identity failure and revoke status %s", async (revokeStatus) => {
+    status = "approved";
+    const original = request.getMockImplementation()!;
+    request.mockImplementation(async (url: string, init: RequestInit) => {
+      if (url === base + "/api/cli-auth/me") return json({ error: "fixture denied" }, 401);
+      if (url === base + "/api/cli-auth/revoke-current") return json({ revoked: true }, revokeStatus);
+      return original(url, init);
+    });
+    expect(await login().catch(e => e)).toBeInstanceOf(Error);
+    expect(request.mock.calls.filter(([url]) => url === base + "/api/cli-auth/revoke-current")).toHaveLength(1);
+    expect(events.some(e => e.stage === "failed_grant_revocation_verified")).toBe(true);
+    expect(getStoredBoardCredential(base, path.join(dir, "auth.json"))).toBeNull();
+  });
+  it("does not retry challenge creation after a network failure", async () => {
+    request.mockRejectedValueOnce(new TypeError("FIXTURE_BOARD_SECRET"));
+    const result = await login().catch(e => e);
+    expect(result).toBeInstanceOf(Error); expect(request).toHaveBeenCalledTimes(1);
+    expect(JSON.stringify(events)).not.toContain("FIXTURE_BOARD_SECRET");
+  });
+});
