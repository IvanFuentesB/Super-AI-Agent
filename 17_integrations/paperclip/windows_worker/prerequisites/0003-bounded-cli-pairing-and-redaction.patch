@@ -0,0 +1,21 @@
+import { afterEach, expect, it, vi } from "vitest";
+import { api } from "../../../ui/src/api/client.js";
+afterEach(() => { vi.restoreAllMocks(); vi.unstubAllGlobals(); });
+it("attaches a safe correlation id without changing credentials or approval body", async () => {
+  const fetch = vi.fn(async () => new Response(JSON.stringify({ ok: true }), { status: 200 }));
+  vi.stubGlobal("fetch", fetch); const log = vi.spyOn(console, "info").mockImplementation(() => {});
+  await api.post("/cli-auth/challenges/11111111-1111-4111-8111-111111111111/approve", { token: "FIXTURE_PRIVATE" });
+  const options = fetch.mock.calls[0][1] as RequestInit;
+  expect(new Headers(options.headers).get("x-paperclip-auth-request-id")).toMatch(/^[0-9a-f-]{36}$/);
+  expect(options.credentials).toBe("include"); expect(options.body).toBe(JSON.stringify({ token: "FIXTURE_PRIVATE" }));
+  expect(log.mock.calls.length).toBe(2); expect(JSON.stringify(log.mock.calls)).not.toContain("FIXTURE_PRIVATE");
+});
+it("reports the failing request id and timestamp, never the secret URL or raw exception", async () => {
+  vi.stubGlobal("fetch", vi.fn(async () => { throw new TypeError("FIXTURE_PRIVATE"); }));
+  const log = vi.spyOn(console, "info").mockImplementation(() => {});
+  const error = await api.get("/cli-auth/challenges/11111111-1111-4111-8111-111111111111?token=FIXTURE_PRIVATE").catch(e => e);
+  expect(error.message).toMatch(/Failed to fetch.*request/i);
+  expect(error.message).not.toContain("FIXTURE_PRIVATE");
+  expect(JSON.stringify(log.mock.calls)).not.toContain("FIXTURE_PRIVATE");
+  expect(log.mock.calls.at(-1)?.[1]).toMatchObject({ phase: "network_failure" });
