+// @vitest-environment jsdom
+import { beforeEach, afterEach, expect, it, vi } from "vitest";
+import { submitNewAgentHire } from "./submit-new-agent-hire";
+
+const payload = { name: "Ghoti Reviewer", role: "engineer", adapterType: "codex_local", adapterConfig: { dangerouslyBypassApprovalsAndSandbox: false, timeoutSec: 180, graceSec: 5 }, runtimeConfig: { heartbeat: { enabled: false, wakeOnDemand: false } } };
+let calls: ReturnType<typeof vi.fn>;
+beforeEach(() => {
+  localStorage.clear();
+  const held = new Set<string>();
+  vi.stubGlobal("navigator", { locks: { request: async (key: string, _options: unknown, callback: (lock: object | null) => Promise<unknown>) => {
+    if (held.has(key)) return callback(null);
+    held.add(key);
+    try { return await callback({ name: key }); } finally { held.delete(key); }
+  } } });
+  calls = vi.fn(async (_url: string, init: RequestInit) => new Response(JSON.stringify(init.method === "POST" ? { agent: { id: "fixture-agent", role: "engineer", status: "pending_approval" }, approval: { id: "fixture-approval", status: "pending" } } : []), { status: init.method === "POST" ? 201 : 200 }));
+  vi.stubGlobal("fetch", calls);
+});
+afterEach(() => { vi.unstubAllGlobals(); localStorage.clear(); });
+
+it("uses the existing credentialed same-origin client and only the hire endpoint", async () => {
+  const result = await submitNewAgentHire("fixture-company", payload);
+  expect(result.approval?.status).toBe("pending");
+  const posts = calls.mock.calls.filter(([, init]) => init.method === "POST");
+  expect(posts).toHaveLength(1);
+  expect(posts[0][0]).toBe("/api/companies/fixture-company/agent-hires");
+  expect(posts[0][1].credentials).toBe("include");
+  expect(JSON.parse(posts[0][1].body as string)).toMatchObject(payload);
+});
+
+it("blocks concurrent duplicate clicks before another POST", async () => {
+  let finish!: () => void;
+  calls.mockImplementationOnce(() => new Promise<Response>((resolve) => { finish = () => resolve(new Response("[]")); }));
+  const first = submitNewAgentHire("fixture-company", payload);
+  await expect(submitNewAgentHire("fixture-company", payload)).rejects.toThrow(/submitted/i);
+  finish(); await first;
+  expect(calls.mock.calls.filter(([, init]) => init.method === "POST")).toHaveLength(1);
+});
+
+it("does not resend an ambiguous failure, even from a newly mounted form", async () => {
+  calls.mockImplementationOnce(async () => new Response("[]"));
+  calls.mockImplementationOnce(async () => { throw new Error("fixture connection lost"); });
+  await expect(submitNewAgentHire("fixture-company", payload)).rejects.toThrow(/fixture connection lost/);
+  await expect(submitNewAgentHire("fixture-company", payload)).rejects.toThrow(/not.*resend|previous|outcome/i);
+  expect(calls.mock.calls.filter(([, init]) => init.method === "POST")).toHaveLength(1);
+});
+
+it("refuses a matching existing agent without creating or renaming one", async () => {
+  calls.mockImplementationOnce(async () => new Response(JSON.stringify([{ id: "existing", name: "  GHOTI REVIEWER  ", role: "engineer", status: "pending_approval" }])));
+  await expect(submitNewAgentHire("fixture-company", payload)).rejects.toThrow(/already exists/i);
+  expect(calls.mock.calls.filter(([, init]) => init.method === "POST")).toHaveLength(0);
+});
+
+it("validates the shared hire schema before requesting anything", async () => {
+  await expect(submitNewAgentHire("fixture-company", { ...payload, role: "not-a-role" })).rejects.toThrow();
+  expect(calls).not.toHaveBeenCalled();
+});
+
+it("keeps server validation errors visible and does not automatically retry", async () => {
+  calls.mockImplementationOnce(async () => new Response("[]"));
+  calls.mockImplementationOnce(async () => new Response(JSON.stringify({ error: "fixture hire rejected" }), { status: 422 }));
+  await expect(submitNewAgentHire("fixture-company", payload)).rejects.toThrow(/fixture hire rejected/);
+  expect(calls.mock.calls.filter(([, init]) => init.method === "POST")).toHaveLength(1);
+});
