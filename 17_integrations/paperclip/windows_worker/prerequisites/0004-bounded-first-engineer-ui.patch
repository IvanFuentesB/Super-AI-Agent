+++ b/ui/src/lib/submit-new-agent-hire.ts
@@ -0,0 +1,35 @@
+import { createAgentHireSchema } from "@paperclipai/shared";
+import { agentsApi } from "../api/agents";
+
+/** Guard this form's submissions, not an API-wide idempotency guarantee. */
+export async function submitNewAgentHire(companyId: string, input: Record<string, unknown>) {
+  const payload = createAgentHireSchema.parse(input);
+  const nameKey = payload.name.trim().toLowerCase();
+  const key = `paperclip.agent-hire:${companyId}:${nameKey}`;
+  if (!navigator.locks) {
+    throw new Error("Safe hire submission requires browser Web Locks. No request was sent.");
+  }
+  // Serialize same-name requests across tabs in this profile. The marker contains
+  // no configuration or credentials and survives a lost response or reload.
+  return navigator.locks.request(key, { ifAvailable: true }, async (lock) => {
+    if (!lock) throw new Error("This hire is already being submitted. Check Agents and Approvals.");
+    const existing = await agentsApi.list(companyId);
+    if (existing.some((agent) => agent.name.trim().toLowerCase() === nameKey)) {
+      throw new Error("An agent with this name already exists. Open Agents and Approvals instead of creating another.");
+    }
+    if (localStorage.getItem(key)) {
+      throw new Error("A previous hire request may have been saved. Check Agents and Approvals; automatic resubmission is blocked.");
+    }
+    localStorage.setItem(key, "submitted");
+    try {
+      const result = await agentsApi.hire(companyId, payload);
+      localStorage.removeItem(key);
+      return result;
+    } catch (error) {
+      // Even a server error can occur after the agent was inserted. Never infer
+      // rollback from HTTP status or an empty list while a request may be running.
+      const message = error instanceof Error ? error.message : "Hire request failed";
+      throw new Error(`${message}. Check Agents and Approvals before any retry; this form will not resend the uncertain request.`);
+    }
+  });
+}
