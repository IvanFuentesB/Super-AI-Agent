+    await flush(); await fill(); await click("Create agent");
+    expect(state.hire).toHaveBeenCalledTimes(1);
+    expect(container.textContent).toContain("Agents and Approvals");
+  });
+  it("checks existing company agents rather than creating a duplicate name", async () => {
+    state.list.mockResolvedValue([{ name: "  GHOTI REVIEWER  ", id: "existing" }]);
+    await render(); await fill(); await click("Create agent");
+    expect(state.hire).not.toHaveBeenCalled();
+    expect(container.textContent).toContain("already exists");
+  });
+  it("shows read/validation/server errors instead of claiming success", async () => {
+    await render(); await fill();
+    state.list.mockRejectedValue(new Error("Company access denied"));
+    await click("Create agent");
+    expect(state.hire).not.toHaveBeenCalled();
+    expect(container.textContent).toContain("Company access denied");
+    state.list.mockResolvedValue([]);
+    state.hire.mockRejectedValue(new Error("Invalid adapter configuration"));
+    await click("Create agent");
+    expect(container.textContent).toContain("Invalid adapter configuration");
+    expect(state.navigate).not.toHaveBeenCalled();
+  });
+});
