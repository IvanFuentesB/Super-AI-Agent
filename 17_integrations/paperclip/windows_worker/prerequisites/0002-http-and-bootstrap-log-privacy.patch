+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const fixture = vi.hoisted(() => ({ messages: [] as string[], hasAdmin: false, inserts: 0, revocations: 0, failure: null as unknown }));
+vi.mock("@clack/prompts", () => ({ log: {
+  info: (text: string) => fixture.messages.push(text),
+  success: (text: string) => fixture.messages.push(text),
+  message: (text: string) => fixture.messages.push(text),
+  error: (text: string) => fixture.messages.push(text),
+} }));
+vi.mock("../config/env.js", () => ({ loadPaperclipEnvFile: () => {} }));
+vi.mock("../config/store.js", () => ({
+  resolveConfigPath: () => "fixture-config",
+  readConfig: () => ({ server: { deploymentMode: "authenticated" } }),
+}));
+// Query operators and storage are inert fixtures: this tests output, not ownership.
+vi.mock("drizzle-orm", () => ({ and: () => undefined, eq: () => undefined, gt: () => undefined, isNull: () => undefined }));
+vi.mock("@paperclipai/db", () => ({
+  instanceUserRoles: { role: "role" }, invites: { inviteType: "type", revokedAt: "revoked", acceptedAt: "accepted", expiresAt: "expires" },
+  createDb: () => ({
+    select: () => ({ from: () => ({ where: async () => { if (fixture.failure !== null) throw fixture.failure; return fixture.hasAdmin ? [{ role: "instance_admin" }] : []; } }) }),
+    update: () => ({ set: () => ({ where: async () => { fixture.revocations += 1; } }) }),
+    insert: () => ({ values: () => ({ returning: async () => { fixture.inserts += 1; return [{ expiresAt: new Date("2030-01-01T00:00:00Z") }]; } }) }),
+    $client: { end: async () => {} },
+  }),
+}));
+
+import { bootstrapCeoInvite } from "./auth-bootstrap-ceo.js";
+const fixtureOptions = { config: "fixture-config", dbUrl: "fixture-db", baseUrl: "http://127.0.0.1:1" };
+
+beforeEach(() => { fixture.messages.length = 0; fixture.hasAdmin = false; fixture.inserts = 0; fixture.revocations = 0; fixture.failure = null; });
+
+describe("bootstrap invitation output privacy", () => {
+  it.each([
+    ["Error", new Error("fixture-password fixture-private-url")],
+    ["non-Error", "fixture-password fixture-private-url"],
+  ])("keeps sensitive %s failure details out of automatic startup logs", async (_kind, failure) => {
+    fixture.failure = failure;
+    await bootstrapCeoInvite({ ...fixtureOptions, printUrl: false });
+    const output = fixture.messages.join("\n");
+    expect(output.includes("fixture-password") || output.includes("fixture-private-url")).toBe(false);
+    expect(output).toContain("Could not create bootstrap invite.");
+    expect(fixture.inserts).toBe(0);
+    expect(fixture.revocations).toBe(0);
+  });
+  it("keeps the existing explicit CLI output behavior", async () => {
+    await bootstrapCeoInvite(fixtureOptions);
+    expect(fixture.messages.some((message) => message.includes("/invite/"))).toBe(true);
+    expect(fixture.inserts).toBe(1);
+  });
+  it("does not put the private URL into startup logs when printing is disabled", async () => {
+    await bootstrapCeoInvite({ ...fixtureOptions, printUrl: false });
+    expect(fixture.messages.some((message) => message.includes("/invite/") || message.includes("pcp_bootstrap_"))).toBe(false);
+    expect(fixture.inserts).toBe(1);
+  });
+  it("preserves an existing administrator without generating or revoking an invitation", async () => {
+    fixture.hasAdmin = true;
+    await bootstrapCeoInvite({ ...fixtureOptions, printUrl: false });
+    expect(fixture.inserts).toBe(0);
+    expect(fixture.revocations).toBe(0);
+  });
+});
