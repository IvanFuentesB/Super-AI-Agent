diff --git a/server/src/__tests__/http-log-privacy.test.ts b/server/src/__tests__/http-log-privacy.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c9b1987a0d2350812b29c0743b07038c1c947988
--- /dev/null
+++ b/server/src/__tests__/http-log-privacy.test.ts
@@ -0,0 +1,69 @@
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import { createServer, type Server } from "node:http";
+import { Writable } from "node:stream";
+import pino from "pino";
+
+vi.mock("../config-file.js", () => ({ readConfigFile: () => null }));
+vi.mock("../home-paths.js", async () => {
+  const { tmpdir } = await import("node:os");
+  return { resolveDefaultLogsDir: () => tmpdir(), resolveHomeAwarePath: (value: string) => value };
+});
+
+// Real Pino and pino-http; replace only the transport with a memory sink.
+// All sensitive-looking values below are inert test fixtures, not credentials.
+const chunks: string[] = [];
+const sink = new Writable({ write(chunk, _encoding, done) { chunks.push(String(chunk)); done(); } });
+let server: Server;
+let base: string;
+const markers = ["fixture-cookie", "fixture-set-cookie", "fixture-password", "fixture-email", "fixture-invite", "fixture-query", "fixture-error"];
+
+beforeAll(async () => {
+  vi.spyOn(pino, "transport").mockReturnValue(sink as ReturnType<typeof pino.transport>);
+  const { httpLogger } = await import("../middleware/logger.js");
+  server = createServer((req, res) => {
+    const fixtureReq = req as typeof req & { body: unknown; params: unknown; query: unknown };
+    fixtureReq.body = { password: markers[2], email: markers[3] };
+    fixtureReq.params = { token: markers[4] };
+    fixtureReq.query = { code: markers[5] };
+    const status = Number(req.headers["x-fixture-status"]);
+    const fixtureRes = res as typeof res & { err?: Error; __errorContext?: unknown };
+    if (status >= 500) {
+      fixtureRes.err = new Error(markers[6]);
+      fixtureRes.__errorContext = { error: { message: markers[6] }, reqBody: fixtureReq.body, reqParams: fixtureReq.params, reqQuery: fixtureReq.query };
+    }
+    httpLogger(req, res);
+    res.statusCode = status;
+    res.setHeader("Set-Cookie", markers[1]);
+    res.end("fixture response");
+  });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address();
+  if (!address || typeof address === "string") throw new Error("No fixture listener");
+  base = `http://127.0.0.1:${address.port}`;
+});
+
+afterAll(async () => {
+  if (server) {
+    server.closeAllConnections();
+    await new Promise<void>((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+  }
+  vi.restoreAllMocks();
+});
+
+describe("HTTP request logging privacy", () => {
+  it.each([200, 400, 401, 500])("keeps request secrets out of logs for status %s", async (status) => {
+    chunks.length = 0;
+    const response = await fetch(`${base}/invite/${markers[4]}?code=${markers[5]}`, {
+      method: "POST",
+      headers: { Cookie: markers[0], Referer: `${base}/invite/${markers[4]}`, "X-Fixture-Status": String(status) },
+      body: markers[2],
+    });
+    await response.text();
+    await vi.waitFor(() => expect(chunks.length).toBeGreaterThan(0));
+    const output = chunks.join("");
+    for (const marker of markers) expect(output).not.toContain(marker);
+    const record = JSON.parse(output.trim());
+    expect(record.req.method).toBe("POST");
+    expect(record.res.statusCode).toBe(status);
+  });
+});
