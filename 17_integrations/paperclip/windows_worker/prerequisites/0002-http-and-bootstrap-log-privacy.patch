+import { afterEach, expect, it, vi } from "vitest";
+
+const bootstrap = vi.hoisted(() => vi.fn(async () => {}));
+// The server and I/O boundaries are inert: this tests startup wiring only.
+vi.mock("node:fs", () => ({ default: { mkdirSync: vi.fn(), existsSync: () => false } }));
+vi.mock("@clack/prompts", () => ({ intro: vi.fn(), log: { message: vi.fn(), step: vi.fn(), error: vi.fn() } }));
+vi.mock("./auth-bootstrap-ceo.js", () => ({ bootstrapCeoInvite: bootstrap }));
+vi.mock("./onboard.js", () => ({ onboard: () => { throw new Error("Must not onboard in this fixture"); } }));
+vi.mock("./doctor.js", () => ({ doctor: async () => ({ failed: 0 }) }));
+vi.mock("../config/env.js", () => ({ loadPaperclipEnvFile: vi.fn() }));
+vi.mock("../config/store.js", () => ({
+  configExists: () => true, resolveConfigPath: () => "fixture-config",
+  readConfig: () => ({ server: { deploymentMode: "authenticated" }, database: { mode: "embedded-postgres" }, auth: { baseUrlMode: "explicit", publicBaseUrl: "http://127.0.0.1:1" } }),
+}));
+vi.mock("../config/home.js", () => ({
+  resolvePaperclipInstanceId: () => "fixture-instance", resolvePaperclipHomeDir: () => "fixture-home",
+  describeLocalInstancePaths: () => ({ instanceRoot: "fixture-root", homeDir: "fixture-home", instanceId: "fixture-instance" }),
+}));
+vi.mock("@paperclipai/server", () => ({ startServer: async () => ({ apiUrl: "http://127.0.0.1:1/api", databaseUrl: "fixture-db", host: "127.0.0.1", listenPort: 1 }) }));
+
+import { runCommand } from "./run.js";
+afterEach(() => { vi.unstubAllEnvs(); bootstrap.mockReset(); bootstrap.mockResolvedValue(undefined); });
+it.each([
+  ["Error", new Error("fixture-sensitive-startup-detail")],
+  ["non-Error", "fixture-sensitive-startup-detail"],
+])("sanitizes unexpected bootstrap %s rejections without treating them as success", async (_kind, reason) => {
+  vi.stubEnv("PAPERCLIP_INSTANCE_ID", "fixture-instance");
+  vi.stubEnv("PAPERCLIP_CONFIG", "fixture-config");
+  bootstrap.mockRejectedValueOnce(reason);
+  let failure: unknown;
+  try { await runCommand({ config: "fixture-config", instance: "fixture-instance" }); }
+  catch (error) { failure = error; }
+  expect(failure).toBeInstanceOf(Error);
+  expect(String(failure).includes("fixture-sensitive-startup-detail")).toBe(false);
+  expect(String(failure)).toContain("Bootstrap invitation setup failed.");
+});
+it("suppresses the private bootstrap URL at the real runCommand call site", async () => {
+  vi.stubEnv("PAPERCLIP_INSTANCE_ID", "fixture-instance");
+  vi.stubEnv("PAPERCLIP_CONFIG", "fixture-config");
+  await runCommand({ config: "fixture-config", instance: "fixture-instance" });
+  expect(bootstrap).toHaveBeenCalledExactlyOnceWith(expect.objectContaining({ config: "fixture-config", dbUrl: "fixture-db", printUrl: false }));
+});
