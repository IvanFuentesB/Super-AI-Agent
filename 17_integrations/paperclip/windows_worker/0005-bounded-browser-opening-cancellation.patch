+++ b/cli/src/__tests__/board-auth-browser-cancellation.test.ts
@@ -0,0 +1,143 @@
+// Inert operation-level regressions: no real browser, network, account or home store.
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+vi.mock("node:child_process", () => ({ spawn: vi.fn(() => { throw new Error("Unexpected browser process"); }) }));
+import { loginBoardCli } from "../client/board-auth.js";
+
+const base = "http://fixture.invalid";
+const id = "11111111-1111-4111-8111-111111111111";
+let dir: string;
+let controller: AbortController;
+let events: string[];
+let request: ReturnType<typeof vi.fn>;
+let onStage: (stage: string) => void;
+let addListener: ReturnType<typeof vi.spyOn>;
+let removeListener: ReturnType<typeof vi.spyOn>;
+const json = (value: unknown) => new Response(JSON.stringify(value));
+function login(openBrowser: () => boolean | Promise<boolean>) {
+  return loginBoardCli({ apiBase: base, requestedAccess: "board", print: false,
+    signal: controller.signal, storePath: path.join(dir, "auth.json"), openBrowser,
+    onEvent: event => { events.push(event.stage); onStage(event.stage); } });
+}
+function observe(promise: ReturnType<typeof login>) {
+  const result: { settled: boolean; value?: unknown; error?: any } = { settled: false };
+  const done = promise.then(value => { result.settled = true; result.value = value; },
+    error => { result.settled = true; result.error = error; });
+  return { result, done };
+}
+function assertNoGrant() {
+  expect(request).toHaveBeenCalledTimes(1);
+  expect(fs.existsSync(path.join(dir, "auth.json"))).toBe(false);
+  expect(events).not.toContain("approved");
+  expect(events).not.toContain("identity_verified");
+  expect(events).not.toContain("credential_stored");
+}
+function assertListenersCleaned() {
+  for (let i = 0; i < addListener.mock.calls.length; i++) {
+    const [type, callback] = addListener.mock.calls[i];
+    if (type !== "abort") continue;
+    const target = addListener.mock.contexts[i];
+    expect(removeListener.mock.calls.some(([t, cb], j) => t === type && cb === callback
+      && removeListener.mock.contexts[j] === target)).toBe(true);
+  }
+  expect(vi.getTimerCount()).toBe(0);
+}
+beforeEach(() => {
+  vi.useFakeTimers(); vi.setSystemTime(new Date("2026-01-01T00:00:00Z"));
+  dir = fs.mkdtempSync(path.join(os.tmpdir(), "paperclip-browser-bound-"));
+  controller = new AbortController(); events = []; onStage = () => {};
+  request = vi.fn(async (url: string) => {
+    if (url === base + "/api/cli-auth/challenges") return json({ id,
+      token: "SYNTHETIC_PAIRING", boardApiToken: "SYNTHETIC_BOARD",
+      approvalUrl: base + "/approval", pollPath: "/cli-auth/challenges/" + id,
+      expiresAt: new Date(Date.now() + 1000).toISOString(), suggestedPollIntervalMs: 500 });
+    if (url.includes("?token=")) return json({ id, status: "approved" });
+    if (url === base + "/api/cli-auth/me") return json({ userId: "SYNTHETIC_USER" });
+    throw new Error("Unexpected fixture route");
+  });
+  vi.stubGlobal("fetch", request);
+  addListener = vi.spyOn(AbortSignal.prototype, "addEventListener");
+  removeListener = vi.spyOn(AbortSignal.prototype, "removeEventListener");
+});
+afterEach(() => {
+  vi.restoreAllMocks(); vi.unstubAllGlobals(); vi.useRealTimers();
+  fs.rmSync(dir, { recursive: true, force: true });
+});
+
+describe("browser opening participates in login cancellation", () => {
+  it("does not create a challenge or open a browser when already aborted", async () => {
+    controller.abort(); const open = vi.fn(() => true);
+    await expect(login(open)).rejects.toThrow();
+    expect(open).not.toHaveBeenCalled(); expect(request).not.toHaveBeenCalled();
+    assertListenersCleaned();
+  });
+  it("does not open after cancellation between challenge response and opening", async () => {
+    onStage = stage => { if (stage === "challenge_created") controller.abort(); };
+    const open = vi.fn(() => true);
+    await expect(login(open)).rejects.toMatchObject({ code: "cli_cancelled" });
+    expect(open).not.toHaveBeenCalled(); assertNoGrant(); assertListenersCleaned();
+  });
+  it.each([
+    ["abort", "resolve"], ["abort", "reject"],
+    ["expiry", "resolve"], ["expiry", "reject"],
+  ] as const)("settles on %s while opening is pending and handles late %s", async (kind, late) => {
+    let resolve!: (value: boolean) => void;
+    let reject!: (error: Error) => void;
+    const pending = new Promise<boolean>((yes, no) => { resolve = yes; reject = no; });
+    const open = vi.fn(() => pending);
+    const { result, done } = observe(login(open));
+    await vi.advanceTimersByTimeAsync(0);
+    expect(open).toHaveBeenCalledTimes(1);
+    if (kind === "abort") controller.abort();
+    await vi.advanceTimersByTimeAsync(kind === "expiry" ? 1001 : 0);
+    try {
+      expect(result.settled).toBe(true); // Must not need callback release.
+      expect(result.error).toMatchObject({ code: kind === "abort" ? "cli_cancelled" : "cli_expired" });
+      assertNoGrant(); assertListenersCleaned();
+      expect(events.filter(s => s === (kind === "abort" ? "cancelled" : "expired"))).toHaveLength(1);
+      const before = [...events];
+      if (late === "resolve") resolve(true); else reject(new Error("Late synthetic opener failure"));
+      await vi.advanceTimersByTimeAsync(0); await done;
+      expect(events).toEqual(before); assertNoGrant(); assertListenersCleaned();
+    } finally {
+      // Release only for fixture cleanup if the regression assertion fails on baseline.
+      resolve(false); await vi.advanceTimersByTimeAsync(0); await done;
+    }
+  });
+  it.each([false, true])("preserves normal opening and success (async=%s)", async asyncOpen => {
+    const open = vi.fn(() => asyncOpen ? Promise.resolve(true) : true);
+    const result = await login(open);
+    expect(result.userId).toBe("SYNTHETIC_USER");
+    expect(open).toHaveBeenCalledTimes(1);
+    expect(events.filter(s => s === "credential_stored")).toHaveLength(1);
+    expect(fs.existsSync(path.join(dir, "auth.json"))).toBe(true);
+    assertListenersCleaned();
+  });
+  it("handles cancellation from inside an opener before its promise is returned", async () => {
+    const error = new Error("Late synthetic rejection");
+    const result = await login(() => { controller.abort(); return Promise.reject(error); }).catch(e => e);
+    expect(result).toMatchObject({ code: "cli_cancelled" });
+    await vi.advanceTimersByTimeAsync(0);
+    assertNoGrant(); assertListenersCleaned();
+  });
+  it("rejects elapsed wall expiry after opening even before timer delivery", async () => {
+    const result = await login(() => { vi.setSystemTime(Date.now() + 1001); return true; }).catch(e => e);
+    expect(result).toMatchObject({ code: "cli_expired" });
+    assertNoGrant(); assertListenersCleaned();
+  });
+  it("preserves false opening as a manual-approval path, not fake login success", async () => {
+    await login(() => false);
+    expect(events).toContain("browser_open_failed");
+    expect(request).toHaveBeenCalledTimes(3);
+    expect(events.filter(s => s === "credential_stored")).toHaveLength(1);
+    assertListenersCleaned();
+  });
+  it.each([false, true])("does not swallow an opener error (async=%s)", async asyncOpen => {
+    const error = new Error("Synthetic opener failure");
+    const open = () => { if (asyncOpen) return Promise.reject(error); throw error; };
+    await expect(login(open)).rejects.toBe(error);
+    assertNoGrant(); assertListenersCleaned();
+  });
+});
